{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-platform:conversation:v1",
  "title": "AgentConversation",
  "type": "object",
  "required": [
    "conversation_id",
    "tenant_id",
    "principal_id",
    "workspace_id",
    "status",
    "last_message_sequence",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "conversation_id": { "type": "string", "minLength": 1 },
    "tenant_id": { "type": "string", "minLength": 1 },
    "principal_id": { "type": "string", "minLength": 1 },
    "workspace_id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "maxLength": 512 },
    "status": { "enum": ["active", "archived", "deleted"] },
    "default_scenario": {
      "type": "object",
      "required": ["id", "version", "definition_digest"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "definition_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "last_message_sequence": { "type": "integer", "minimum": 0 },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "archived_at": { "type": "string", "format": "date-time" },
    "deleted_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "archived" } }, "required": ["status"] },
      "then": { "required": ["archived_at"] }
    },
    {
      "if": { "properties": { "status": { "const": "deleted" } }, "required": ["status"] },
      "then": { "required": ["deleted_at"] }
    }
  ],
  "x-semantic-constraints": [
    "one Conversation owns one durable Workspace and zero or more WorkOrders",
    "messages are append-only and strictly ordered by conversation-local message_sequence",
    "at most one active WorkOrder may mutate the same branch unless the Scenario explicitly permits parallel turns",
    "lifecycle transitions follow contracts/state-machines/conversation-v1.json and deleted is irreversible"
  ]
}
