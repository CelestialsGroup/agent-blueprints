{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-platform:admitted-capability-definition:v1",
  "title": "AdmittedCapabilityDefinition",
  "type": "object",
  "required": ["id", "version", "profile", "definition_digest", "allowed_provider_kinds"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "profile": { "type": ["string", "null"] },
    "definition_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "allowed_provider_kinds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["agent_runtime", "sandbox", "model", "tool", "skill", "template", "renderer", "editor", "converter", "channel"] }
    }
  },
  "additionalProperties": false
}
