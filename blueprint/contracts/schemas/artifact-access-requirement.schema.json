{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-platform:artifact-access-requirement:v1",
  "title": "ArtifactAccessRequirement",
  "description": "Immutable access requirement admitted in a RunManifest. It contains no bearer authority or expiry.",
  "type": "object",
  "required": [
    "requirement_id", "tenant_id", "work_order_id", "artifact_id", "version_id",
    "artifact_digest", "allowed_permissions"
  ],
  "properties": {
    "requirement_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "tenant_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "work_order_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "artifact_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "version_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "artifact_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "allowed_permissions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": { "enum": ["read", "stage_new_version"] }
    }
  },
  "additionalProperties": false,
  "x-semantic-constraints": [
    "the requirement binds one immutable ArtifactVersion and contains no token, route credential, issued_at or expires_at",
    "a fresh ArtifactGrant may cover the requirement only with the same Tenant, WorkOrder, ArtifactVersion, digest and a subset of allowed_permissions"
  ]
}
