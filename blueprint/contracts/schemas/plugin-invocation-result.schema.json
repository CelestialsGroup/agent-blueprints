{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-platform:plugin-invocation-result:v1",
  "title": "PluginInvocationResult",
  "type": "object",
  "required": [
    "invocation_id",
    "provider_operation_id",
    "output",
    "staged_artifacts",
    "usage",
    "completed_at",
    "invocation_attempt_id",
    "fencing_token"
  ],
  "properties": {
    "invocation_id": {
      "type": "string"
    },
    "provider_operation_id": {
      "type": "string"
    },
    "output": {
      "type": "object"
    },
    "staged_artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "staging_id",
          "name",
          "media_type",
          "role",
          "digest",
          "size_bytes",
          "staging_session_id",
          "invocation_id",
          "invocation_attempt_id"
        ],
        "properties": {
          "staging_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "media_type": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "manifest": {
            "type": "object"
          },
          "staging_session_id": {
            "type": "string"
          },
          "invocation_id": {
            "type": "string"
          },
          "invocation_attempt_id": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "usage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "entry_id",
          "meter",
          "quantity",
          "unit",
          "occurred_at",
          "meter_source"
        ],
        "properties": {
          "entry_id": {
            "type": "string"
          },
          "meter": {
            "type": "string"
          },
          "quantity": {
            "type": "integer",
            "description": "Signed integer in the meter's registered base unit; corrections may be negative."
          },
          "unit": {
            "type": "string"
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time"
          },
          "provider_operation_id": {
            "type": "string"
          },
          "meter_source": {
            "enum": [
              "platform_metered",
              "provider_reported",
              "reconciled"
            ]
          },
          "evidence_reference": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "invocation_attempt_id": {
      "type": "string"
    },
    "fencing_token": {
      "type": "integer",
      "minimum": 1
    }
  },
  "additionalProperties": false
}
