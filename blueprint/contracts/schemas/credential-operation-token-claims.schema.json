{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-platform:credential-operation-token-claims:v1",
  "title": "CredentialOperationTokenClaims",
  "type": "object",
  "required": [
    "iss", "sub", "aud", "jti", "iat", "nbf", "exp", "tenant_id", "secret_grant_id",
    "secret_grant_digest", "operation", "request_contract_id", "request_digest_profile", "request_digest"
  ],
  "properties": {
    "iss": { "type": "string", "minLength": 1, "maxLength": 500 },
    "sub": { "type": "string", "minLength": 1, "maxLength": 500 },
    "aud": { "type": "string", "pattern": "^urn:agent-platform:credential-gateway:[A-Za-z0-9._:-]{1,200}$" },
    "jti": { "type": "string", "minLength": 16, "maxLength": 200 },
    "iat": { "type": "integer", "minimum": 0 },
    "nbf": { "type": "integer", "minimum": 0 },
    "exp": { "type": "integer", "minimum": 1 },
    "tenant_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "secret_grant_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "secret_grant_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "operation": { "const": "credential_access" },
    "request_contract_id": { "const": "urn:agent-platform:credential-access-request:v1" },
    "request_digest_profile": { "const": "rfc8785-request-excluding-request-digest-v1" },
    "request_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  },
  "additionalProperties": false,
  "x-semantic-constraints": [
    "nbf equals or follows SecretGrant issuance, exp is no later than SecretGrant expiry, and token lifetime is no more than 300 seconds",
    "sub equals the authenticated sender-constrained workload identity and aud identifies one admitted Credential Gateway",
    "operation, Contract, Digest Profile and digest bind exactly one CredentialAccessRequest; jti is consumed once"
  ]
}
