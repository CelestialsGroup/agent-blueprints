{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-platform:effective-execution-limits:v1",
  "title": "EffectiveExecutionLimits",
  "description": "Complete fail-closed execution limits. Every field is required; omission never means unlimited or platform default.",
  "type": "object",
  "required": [
    "max_input_tokens",
    "max_output_tokens",
    "max_model_requests",
    "max_sandbox_seconds",
    "max_network_bytes",
    "max_storage_bytes",
    "max_artifact_count",
    "max_conversion_count",
    "max_agent_runs",
    "max_agent_depth",
    "max_parallel_agent_runs"
  ],
  "properties": {
    "max_input_tokens": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "max_output_tokens": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "max_model_requests": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "max_sandbox_seconds": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "max_network_bytes": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "max_storage_bytes": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "max_artifact_count": { "type": "integer", "minimum": 0, "maximum": 1000000 },
    "max_conversion_count": { "type": "integer", "minimum": 0, "maximum": 1000000 },
    "max_agent_runs": { "type": "integer", "minimum": 1, "maximum": 10000 },
    "max_agent_depth": { "type": "integer", "minimum": 0, "maximum": 64 },
    "max_parallel_agent_runs": { "type": "integer", "minimum": 1, "maximum": 10000 }
  },
  "additionalProperties": false
}
