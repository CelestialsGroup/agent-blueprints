{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-platform:ui-extension-manifest:v1",
  "title": "UiExtensionManifest",
  "description": "Signed, isolated UI contribution. Arbitrary remote JavaScript and unsandboxed host imports are forbidden.",
  "type": "object",
  "required": [
    "extension_id",
    "version",
    "provider_revision",
    "bundle_artifact",
    "slots",
    "message_protocol_version",
    "isolation",
    "requested_permissions",
    "manifest_digest",
    "lifecycle"
  ],
  "properties": {
    "extension_id": { "type": "string", "pattern": "^[a-z][a-z0-9./_-]{2,191}$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
    "provider_revision": { "$ref": "urn:agent-platform:provider-revision-snapshot:v1" },
    "bundle_artifact": {
      "type": "object",
      "required": ["artifact_id", "version_id", "digest", "media_type"],
      "properties": {
        "artifact_id": { "type": "string", "minLength": 1 },
        "version_id": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "media_type": { "const": "application/vnd.agent.ui-extension+zip" }
      },
      "additionalProperties": false
    },
    "slots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "scenario.input.before",
          "scenario.input.after",
          "workspace.preview",
          "workspace.artifact-actions",
          "artifact.editor",
          "runtime.side-panel"
        ]
      }
    },
    "message_protocol_version": { "const": "ui-extension/v1" },
    "isolation": {
      "type": "object",
      "required": ["mode", "origin", "csp_profile"],
      "properties": {
        "mode": { "const": "sandboxed_iframe" },
        "origin": { "const": "opaque" },
        "csp_profile": { "enum": ["preview-readonly-v1", "editor-controlled-v1"] }
      },
      "additionalProperties": false
    },
    "requested_permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["artifact:read", "artifact:draft", "catalog:read", "work:read"] }
    },
    "manifest_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "lifecycle": { "enum": ["experimental", "stable", "deprecated", "retired"] }
  },
  "additionalProperties": false,
  "x-semantic-constraints": [
    "bundle ArtifactVersion, ProviderRevision and Manifest are immutable and certified together",
    "host communication uses a typed postMessage allowlist and object-scoped grants",
    "extensions cannot receive WorkSession cookies, raw tokens, arbitrary network access or host DOM access"
  ]
}
