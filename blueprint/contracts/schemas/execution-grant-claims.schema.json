{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-platform:execution-grant-claims:v1",
  "title": "ExecutionGrantClaims",
  "type": "object",
  "required": [
    "jti",
    "iss",
    "aud",
    "sub",
    "iat",
    "nbf",
    "exp",
    "client_app_id",
    "external_tenant_id",
    "external_principal_id",
    "principal_context",
    "principal_context_digest",
    "conversation_id",
    "branch_id",
    "request_contract_id",
    "request_digest_profile",
    "request_digest",
    "idempotency_key_digest",
    "usage",
    "nonce",
    "capabilities",
    "limits",
    "policies",
    "commercial_authorization"
  ],
  "properties": {
    "jti": {
      "type": "string",
      "minLength": 1
    },
    "iss": {
      "type": "string",
      "minLength": 1
    },
    "aud": {
      "const": "agent-platform"
    },
    "sub": {
      "type": "string",
      "minLength": 1
    },
    "iat": {
      "type": "integer",
      "minimum": 0
    },
    "nbf": {
      "type": "integer",
      "minimum": 0
    },
    "exp": {
      "type": "integer",
      "minimum": 0
    },
    "client_app_id": {
      "type": "string",
      "minLength": 1
    },
    "external_tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "external_principal_id": {
      "type": "string",
      "minLength": 1
    },
    "principal_context_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "principal_context": {
      "$ref": "urn:agent-platform:principal-context-snapshot:v1"
    },
    "work_order_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "control_request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "conversation_id": {
      "type": "string",
      "minLength": 1
    },
    "turn_id": {
      "type": "string",
      "minLength": 1
    },
    "branch_id": {
      "type": "string",
      "minLength": 1
    },
    "client_message_id": {
      "type": "string",
      "minLength": 1
    },
    "scenario_id": {
      "type": "string",
      "minLength": 1
    },
    "request_contract_id": {
      "enum": [
        "urn:agent-platform:work-order-request:v1",
        "urn:agent-platform:conversation-turn-request:v1",
        "urn:agent-platform:work-order-control-request:v1"
      ]
    },
    "request_digest_profile": {
      "const": "rfc8785-request-excluding-execution-grant-v1"
    },
    "request_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "idempotency_key_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "usage": {
      "const": "single"
    },
    "nonce": {
      "type": "string",
      "minLength": 16
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "limits": { "$ref": "urn:agent-platform:effective-execution-limits:v1" },
    "policies": {
      "type": "object",
      "required": [
        "network_access",
        "external_communication",
        "data_classification"
      ],
      "properties": {
        "network_access": {
          "enum": [
            "none",
            "restricted",
            "full"
          ]
        },
        "external_communication": {
          "type": "boolean"
        },
        "require_approval_for": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "data_classification": {
          "enum": [
            "public",
            "internal",
            "confidential",
            "restricted"
          ]
        }
      },
      "additionalProperties": false
    },
    "commercial_authorization": {
      "$ref": "urn:agent-platform:commercial-authorization-snapshot:v1"
    },
    "scenario_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "scenario_definition_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": { "request_contract_id": { "const": "urn:agent-platform:work-order-control-request:v1" } },
        "required": ["request_contract_id"]
      },
      "then": {
        "required": ["work_order_id", "control_request_id"],
        "not": {
          "anyOf": [
            { "required": ["turn_id"] },
            { "required": ["client_message_id"] },
            { "required": ["scenario_id"] },
            { "required": ["scenario_version"] },
            { "required": ["scenario_definition_digest"] }
          ]
        }
      },
      "else": {
        "required": ["turn_id", "client_message_id", "scenario_id", "scenario_version", "scenario_definition_digest"],
        "not": {
          "anyOf": [
            { "required": ["work_order_id"] },
            { "required": ["control_request_id"] }
          ]
        }
      }
    }
  ],
  "x-semantic-constraints": [
    "nbf <= iat + 30",
    "iat < exp",
    "exp - iat <= 300",
    "request_contract_id identifies the exact submitted request schema and request_digest is RFC 8785 JCS SHA-256 over that request excluding only execution_grant",
    "principal_context_digest matches principal_context, whose Tenant, Principal and ClientApplication fields match the Grant claims",
    "turn requests bind conversation, turn, branch, client_message and scenario while control requests bind only conversation, branch, WorkOrder and control_request to the submitted request and authenticated path context",
    "limits and capabilities do not exceed commercial_authorization",
    "the Grant validity window is fully covered by principal_context and commercial_authorization validity windows"
  ]
}
