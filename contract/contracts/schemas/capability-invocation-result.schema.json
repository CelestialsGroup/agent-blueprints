{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-platform:capability-invocation-result:v1",
  "title": "CapabilityInvocationResult",
  "type": "object",
  "required": [
    "invocation_id", "invocation_attempt_id", "fencing_token", "invocation_request_digest", "provider_operation_id",
    "output", "output_schema_digest", "staged_artifacts", "usage", "completed_at"
  ],
  "properties": {
    "invocation_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "invocation_attempt_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "fencing_token": { "type": "integer", "minimum": 1 },
    "invocation_request_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "provider_operation_id": { "type": "string", "minLength": 1, "maxLength": 500 },
    "output": { "type": "object", "maxProperties": 256 },
    "output_schema_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "staged_artifacts": {
      "type": "array",
      "maxItems": 256,
      "items": { "$ref": "urn:agent-platform:artifact-staging:v1" }
    },
    "usage": {
      "type": "array",
      "maxItems": 256,
      "items": { "$ref": "urn:agent-platform:usage-observation:v1" }
    },
    "completed_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false,
  "x-semantic-constraints": [
    "output validates against the request-bound output_schema_digest before platform acceptance",
    "staged artifacts are quarantined until digest, size, media policy and InvocationAttempt bindings pass finalize checks",
    "Provider usage contains UsageObservation only; Platform creates immutable TechnicalUsageEntry ledger rows after validation"
  ]
}
