{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-platform:edit-session:v1",
  "title": "EditSession",
  "type": "object",
  "required": ["edit_session_id", "artifact_operation", "status", "mode", "created_at", "expires_at", "draft_revision"],
  "properties": {
    "edit_session_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "artifact_operation": { "$ref": "urn:agent-platform:artifact-operation:v1" },
    "status": { "enum": ["active", "committing", "committed", "conflicted", "discarded", "expired"] },
    "mode": { "enum": ["native", "source", "structural", "annotation", "metadata"] },
    "draft_reference": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "created_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "draft_revision": { "type": "integer", "minimum": 0 },
    "committed_version_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "committed_version_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "committed" } }, "required": ["status"] },
      "then": { "required": ["committed_version_id", "committed_version_digest"] }
    }
  ],
  "x-semantic-constraints": [
    "EditSession is a CAS draft projection over one admitted ArtifactOperation and cannot dispatch Provider work outside its bound Invocation",
    "committed is set only after Platform ArtifactVersion finalization, never on Provider response or staging commit"
  ]
}
