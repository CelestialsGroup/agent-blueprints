{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-platform:artifact-ingest-scan-result:v1",
  "title": "ArtifactIngestScanResult",
  "type": "object",
  "required": [
    "scan_result_id", "scan_result_digest", "ingest_session_id", "content_digest",
    "scanner_provider_revision_id", "scanner_profile", "scanner_suite_digest", "result",
    "evidence_reference", "evidence_digest", "completed_at"
  ],
  "properties": {
    "scan_result_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "scan_result_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "ingest_session_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "content_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "scanner_provider_revision_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "scanner_profile": { "type": "string", "minLength": 1, "maxLength": 200 },
    "scanner_suite_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "result": { "enum": ["passed", "rejected", "error"] },
    "reason_codes": {
      "type": "array", "maxItems": 32, "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,127}$" }
    },
    "evidence_reference": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "evidence_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "completed_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "result": { "enum": ["rejected", "error"] } }, "required": ["result"] },
      "then": { "required": ["reason_codes"], "properties": { "reason_codes": { "minItems": 1 } } }
    }
  ],
  "x-semantic-constraints": [
    "scan_result_digest is RFC 8785 JCS SHA-256 over the result excluding scan_result_digest",
    "content digest, scanner ProviderRevision, profile, suite and immutable evidence are verified before the result is accepted",
    "only passed can enter ready_to_finalize; rejected and error close without ArtifactVersion creation"
  ]
}
