{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-platform:semantic-constraint-traceability:v1",
  "title": "SemanticConstraintTraceability",
  "type": "object",
  "required": ["traceability_id", "version", "generated_at", "critical_schema_ids", "constraints"],
  "properties": {
    "traceability_id": { "const": "phase0-critical-semantic-constraints" },
    "version": { "type": "integer", "minimum": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "critical_schema_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "constraints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["constraint_id", "schema_id", "constraint_index", "statement", "enforcements"],
        "properties": {
          "constraint_id": { "type": "string", "pattern": "^sem-[0-9a-f]{16}$" },
          "schema_id": { "type": "string", "minLength": 1 },
          "constraint_index": { "type": "integer", "minimum": 0 },
          "statement": { "type": "string", "minLength": 1 },
          "enforcements": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "required": ["kind", "artifact", "check_id", "status"],
              "properties": {
                "kind": { "enum": ["json_schema", "semantic_validator", "openapi_gate", "state_machine", "ddl_responsibility", "conformance_test"] },
                "artifact": { "type": "string", "minLength": 1 },
                "check_id": { "type": "string", "minLength": 1 },
                "status": { "enum": ["contract_gate", "phase0_implementation_required", "phase1_production_evidence_required"] }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
