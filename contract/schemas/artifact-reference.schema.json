{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-platform:artifact-reference:v1",
  "title": "ArtifactReference",
  "type": "object",
  "required": [
    "artifact_id",
    "version_id",
    "name",
    "media_type",
    "role",
    "digest",
    "size_bytes"
  ],
  "properties": {
    "artifact_id": {
      "type": "string"
    },
    "version_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "media_type": {
      "type": "string"
    },
    "role": {
      "enum": [
        "primary",
        "source",
        "preview",
        "derived",
        "attachment"
      ]
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "size_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "access_url": {
      "type": "string",
      "format": "uri"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
