{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-platform:event-page:v1",
  "title": "EventPage",
  "type": "object",
  "required": ["events", "next_work_sequence"],
  "properties": {
    "events": {
      "type": "array",
      "items": { "$ref": "urn:agent-platform:canonical-event:v2" }
    },
    "next_work_sequence": { "type": "integer", "minimum": 0 }
  },
  "additionalProperties": false
}
