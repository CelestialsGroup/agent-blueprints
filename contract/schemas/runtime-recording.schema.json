{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-platform:runtime-recording:v1",
  "title": "RuntimeRecording",
  "description": "Platform-owned playback manifest. Live RuntimeSession transport and historical recording are separate resources.",
  "type": "object",
  "required": [
    "recording_id",
    "tenant_id",
    "conversation_id",
    "work_order_id",
    "sandbox_id",
    "runtime_session_id",
    "status",
    "channels",
    "recording_policy_digest",
    "classification",
    "retention_until",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "recording_id": { "type": "string", "minLength": 1 },
    "tenant_id": { "type": "string", "minLength": 1 },
    "conversation_id": { "type": "string", "minLength": 1 },
    "work_order_id": { "type": "string", "minLength": 1 },
    "sandbox_id": { "type": "string", "minLength": 1 },
    "runtime_session_id": { "type": "string", "minLength": 1 },
    "status": { "enum": ["recording", "finalizing", "ready", "failed", "deleted"] },
    "channels": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["terminal", "browser", "desktop", "file_delta"] }
    },
    "recording_policy_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "classification": { "enum": ["internal", "confidential", "restricted"] },
    "retention_until": { "type": "string", "format": "date-time" },
    "chunk_count": { "type": "integer", "minimum": 0 },
    "manifest_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": "string", "format": "date-time" },
    "deleted_at": { "type": "string", "format": "date-time" },
    "error": { "$ref": "urn:agent-platform:capability-error:v1" }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "ready" } }, "required": ["status"] },
      "then": { "required": ["manifest_digest", "completed_at"] }
    },
    {
      "if": { "properties": { "status": { "const": "failed" } }, "required": ["status"] },
      "then": { "required": ["error", "completed_at"] }
    },
    {
      "if": { "properties": { "status": { "const": "deleted" } }, "required": ["status"] },
      "then": { "required": ["deleted_at"] }
    }
  ],
  "x-semantic-constraints": [
    "transitions follow state-machines/runtime-recording-v1.json",
    "ready requires a complete immutable manifest; partial finalization cannot be represented as ready",
    "deleted is an irreversible tombstone and does not imply deletion of retained audit decisions"
  ]
}
