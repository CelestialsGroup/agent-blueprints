{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-platform:delivery-package:v1",
  "title": "DeliveryPackage",
  "type": "object",
  "required": [
    "delivery_id",
    "work_order_id",
    "status",
    "artifacts",
    "usage_accounting",
    "completed_at"
  ],
  "properties": {
    "delivery_id": {
      "type": "string"
    },
    "work_order_id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "completed",
        "partial",
        "failed",
        "cancelled"
      ]
    },
    "summary": {
      "type": "string"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "artifact_id",
          "version_id",
          "name",
          "media_type",
          "role",
          "digest",
          "size_bytes"
        ],
        "properties": {
          "artifact_id": {
            "type": "string"
          },
          "version_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "media_type": {
            "type": "string"
          },
          "role": {
            "enum": [
              "primary",
              "source",
              "preview",
              "derived",
              "attachment"
            ]
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "access_url": {
            "type": "string",
            "format": "uri"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      }
    },
    "usage_accounting": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "usage_report"],
          "properties": {
            "kind": { "const": "usage_report" },
            "usage_report": { "$ref": "urn:agent-platform:usage-report:v1" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "no_usage_attestation"],
          "properties": {
            "kind": { "const": "confirmed_no_usage" },
            "no_usage_attestation": { "$ref": "urn:agent-platform:no-usage-attestation:v1" }
          },
          "additionalProperties": false
        }
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false,
  "x-semantic-constraints": [
    "delivery remains pending until usage is represented by a non-empty UsageReport or an immutable NoUsageAttestation; missing accounting never means zero",
    "usage accounting tenant and CommercialAuthorization match the delivered WorkOrder and execution_scope is exactly that work_order_id"
  ]
}
