{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-platform:runtime-session-request:v1",
  "title": "CreateRuntimeSessionRequest",
  "type": "object",
  "required": [
    "runtime_type",
    "sandbox_slot_key",
    "recording"
  ],
  "properties": {
    "runtime_type": {
      "enum": [
        "terminal",
        "browser",
        "desktop",
        "port_forward"
      ]
    },
    "sandbox_slot_key": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9/_-]{0,127}$"
    },
    "requested_scopes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "view",
          "control",
          "input",
          "clipboard",
          "file-transfer"
        ]
      }
    },
    "recording": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["disabled", "platform_managed"] },
        "channels": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["terminal", "browser", "desktop", "file_delta"] }
        },
        "classification": { "enum": ["internal", "confidential", "restricted"] },
        "retention_days": { "type": "integer", "minimum": 1, "maximum": 3650 },
        "consent_reference": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "mode": { "const": "platform_managed" } }, "required": ["mode"] },
          "then": { "required": ["channels", "classification", "retention_days"] }
        }
      ]
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "runtime_type": { "const": "port_forward" } }, "required": ["runtime_type"] },
      "then": { "properties": { "recording": { "properties": { "mode": { "const": "disabled" } } } } }
    },
    {
      "if": { "properties": { "runtime_type": { "const": "terminal" } }, "required": ["runtime_type"] },
      "then": { "properties": { "recording": { "properties": { "channels": { "items": { "enum": ["terminal", "file_delta"] } } } } } }
    },
    {
      "if": { "properties": { "runtime_type": { "const": "browser" } }, "required": ["runtime_type"] },
      "then": { "properties": { "recording": { "properties": { "channels": { "items": { "enum": ["browser", "file_delta"] } } } } } }
    },
    {
      "if": { "properties": { "runtime_type": { "const": "desktop" } }, "required": ["runtime_type"] },
      "then": { "properties": { "recording": { "properties": { "channels": { "items": { "enum": ["desktop", "file_delta"] } } } } } }
    }
  ],
  "x-semantic-constraints": [
    "requested scopes must be a subset of the authenticated WorkSession and WorkOrder policy",
    "sandbox_slot_key selects exactly one Sandbox slot from the admitted RunManifest and cannot resolve a provider-native Sandbox identity",
    "control, input, clipboard, or file-transfer requires runtime:control; view-only requires runtime:view",
    "platform_managed recording is created by Runtime Gateway and never delegated to the Sandbox Provider as an authorization decision",
    "recording channels are compatible with runtime_type; port_forward is live-only and requires disabled recording"
  ]
}
