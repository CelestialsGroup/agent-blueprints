          "category": "security",
          "evidence_type": "test_log",
          "description": "Connection and control scopes match the authenticated RuntimeSession."
        },
        {
          "test_id": "stale-generation-rejected",
          "category": "ordering",
          "evidence_type": "test_log",
          "description": "Frames from an older connection generation are rejected."
        },
        {
          "test_id": "resume-no-gap",
          "category": "recovery",
          "evidence_type": "trace",
          "description": "Reconnect within the resume window replays frames without gaps or duplicates."
        },
        {
          "test_id": "resume-expired-explicit",
          "category": "recovery",
          "evidence_type": "test_log",
          "description": "Expired resume state directs the client to immutable recording playback."
        },
        {
          "test_id": "ack-backpressure",
          "category": "ordering",
          "evidence_type": "trace",
          "description": "Sender honors acknowledgement and receive-window limits."
        },
        {
          "test_id": "control-idempotent",
          "category": "ordering",
          "evidence_type": "test_log",
          "description": "Repeated control command IDs do not repeat side effects."
        },
        {
          "test_id": "recording-alignment",
          "category": "recording",
          "evidence_type": "artifact",
          "description": "Recording checkpoints bind channel sequence to WorkOrder work_sequence."
        },
        {
          "test_id": "secret-redaction",
          "category": "recording",
          "evidence_type": "artifact",
          "description": "Finalized chunks contain no token, authorization header or registered secret shape."
        },
        {
          "test_id": "raw-persistence-denied",
          "category": "recording",
          "evidence_type": "trace",
          "description": "Unredacted live frames remain memory-bounded and cannot become an ArtifactVersion, database payload or durable queue record."
        },
        {
          "test_id": "gateway-restart-reroute",
          "category": "multi_node",
          "evidence_type": "trace",
          "description": "Gateway restart or reroute increments generation and preserves authorized recovery."
        },
        {
          "test_id": "cross-tenant-route-denied",
          "category": "security",
          "evidence_type": "test_log",
          "description": "Route lookup cannot resolve another tenant, principal or WorkOrder."
        }
      ]
    }
  ]
