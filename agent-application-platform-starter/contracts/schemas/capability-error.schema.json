{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-platform:capability-error:v1",
  "title": "CapabilityError",
  "type": "object",
  "required": [
    "code",
    "message",
    "retryable",
    "outcome"
  ],
  "properties": {
    "code": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{2,127}$"
    },
    "message": {
      "type": "string"
    },
    "retryable": {
      "type": "boolean"
    },
    "outcome": {
      "enum": [
        "known_failed",
        "outcome_unknown"
      ]
    },
    "provider_code": {
      "type": "string"
    },
    "details": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
