{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-platform:artifact-grant:v1",
  "title": "ArtifactGrant",
  "type": "object",
  "required": [
    "grant_id", "tenant_id", "work_order_id", "runtime_run_id", "artifact_id", "version_id",
    "artifact_digest", "permissions", "gateway_route_id", "issued_at", "expires_at"
  ],
  "properties": {
    "grant_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "tenant_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "work_order_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "runtime_run_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "artifact_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "version_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "artifact_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "permissions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "enum": ["read", "write_new_version", "finalize"] }
    },
    "gateway_route_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "issued_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false,
  "x-semantic-constraints": [
    "expires_at is later than issued_at and no later than the Runtime Invocation authorization",
    "the grant is tenant, WorkOrder, RuntimeRun, immutable ArtifactVersion and Artifact Gateway route bound"
  ]
}
