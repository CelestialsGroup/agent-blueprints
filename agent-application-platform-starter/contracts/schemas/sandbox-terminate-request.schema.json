{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-platform:sandbox-terminate-request:v1",
  "title": "TerminateSandboxRequest",
  "allOf": [
    {
      "$ref": "urn:agent-platform:sandbox-mutation-envelope:v1"
    },
    {
      "type": "object",
      "required": [
        "expected_generation",
        "reason",
        "preserve_workspace_snapshot"
      ],
      "properties": {
        "expected_generation": {
          "type": "integer",
          "minimum": 1
        },
        "reason": {
          "type": "string"
        },
        "preserve_workspace_snapshot": {
          "type": "boolean"
        }
      }
    }
  ],
  "unevaluatedProperties": false
}
