{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-platform:invocation-manual-review-decision:v1",
  "title": "InvocationManualReviewDecision",
  "type": "object",
  "required": ["decision_id", "case_id", "invocation_id", "decision", "operator_principal", "evidence_references", "reason", "risk_accepted", "occurred_at", "decision_digest"],
  "properties": {
    "decision_id": { "type": "string", "minLength": 1 },
    "case_id": { "type": "string", "minLength": 1 },
    "invocation_id": { "type": "string", "minLength": 1 },
    "decision": { "enum": ["resolve_success", "resolve_failure", "resolve_cancelled", "retry", "abandon"] },
    "operator_principal": { "type": "string", "minLength": 1 },
    "evidence_references": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "uniqueItems": true },
    "reason": { "type": "string", "minLength": 1 },
    "risk_accepted": { "type": "boolean" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "decision_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "decision": { "const": "abandon" } }, "required": ["decision"] },
      "then": { "properties": { "risk_accepted": { "const": true } } }
    }
  ],
  "x-semantic-constraints": ["decision_digest is RFC 8785 SHA-256 over the decision excluding decision_digest", "decisions are append-only"]
}
