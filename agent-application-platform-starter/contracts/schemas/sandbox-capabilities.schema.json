{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-platform:sandbox-capabilities:v1",
  "title": "SandboxCapabilities",
  "type": "object",
  "required": [
    "provider_revision_id",
    "api_version",
    "capabilities",
    "runtime_profiles",
    "snapshot_restore_profiles",
    "limits"
  ],
  "properties": {
    "provider_revision_id": {
      "type": "string"
    },
    "api_version": {
      "const": "v1"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "versions"
        ],
        "properties": {
          "id": {
            "enum": [
              "sandbox.exec",
              "sandbox.terminal",
              "sandbox.browser",
              "sandbox.desktop",
              "sandbox.port-forward",
              "sandbox.workspace.persistent",
              "sandbox.snapshot.workspace",
              "sandbox.snapshot.filesystem",
              "sandbox.snapshot.process",
              "sandbox.restore",
              "sandbox.network-policy",
              "sandbox.gpu",
              "sandbox.nested-container",
              "sandbox.user-namespace"
            ]
          },
          "versions": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "profiles": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "runtime_profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "isolation_class"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "isolation_class": {
            "enum": [
              "container",
              "hardened-container",
              "microvm",
              "virtual-machine",
              "local-process"
            ]
          },
          "runtime_class_name": {
            "type": "string"
          },
          "architecture": {
            "type": "array",
            "items": {
              "enum": [
                "amd64",
                "arm64"
              ]
            }
          }
        },
        "additionalProperties": false
      }
    },
    "snapshot_restore_profiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["profile_id", "level", "suite_id", "suite_version", "suite_digest"],
        "properties": {
          "profile_id": { "type": "string", "minLength": 1, "maxLength": 200 },
          "level": { "enum": ["workspace", "filesystem", "process"] },
          "suite_id": { "const": "sandbox-provider" },
          "suite_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
          "suite_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
        },
        "additionalProperties": false
      }
    },
    "limits": {
      "type": "object",
      "required": [
        "max_cpu_millis",
        "max_memory_bytes",
        "max_ephemeral_storage_bytes",
        "max_lease_seconds",
        "max_exec_seconds"
      ],
      "properties": {
        "max_cpu_millis": {
          "type": "integer",
          "minimum": 1
        },
        "max_memory_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "max_ephemeral_storage_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "max_workspace_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "max_gpu_count": {
          "type": "integer",
          "minimum": 0
        },
        "max_lease_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "max_exec_seconds": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "x-semantic-constraints": [
    "every advertised snapshot or restore capability maps to an explicit content-addressed snapshot_restore_profile for the same level",
    "profile advertisement cannot authorize restoration without an exact compatible Platform CompatibilityDecision"
  ]
}
