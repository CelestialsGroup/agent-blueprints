{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-platform:provider-health:v1",
  "title": "ProviderHealth",
  "type": "object",
  "required": [
    "provider_instance_id",
    "provider_revision_id",
    "health_generation",
    "status",
    "observed_at",
    "cluster_id",
    "observations"
  ],
  "properties": {
    "provider_instance_id": {
      "type": "string"
    },
    "provider_revision_id": { "type": "string", "minLength": 1 },
    "health_generation": { "type": "integer", "minimum": 1 },
    "status": {
      "enum": [
        "healthy",
        "degraded",
        "unhealthy",
        "draining",
        "disabled"
      ]
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "cluster_id": {
      "type": "string"
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "probe",
          "status",
          "observed_at"
        ],
        "properties": {
          "probe": {
            "enum": [
              "readiness",
              "liveness",
              "conformance",
              "dependency",
              "capacity"
            ]
          },
          "status": {
            "enum": [
              "pass",
              "warn",
              "fail"
            ]
          },
          "latency_ms": {
            "type": "number",
            "minimum": 0
          },
          "message": {
            "type": "string"
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      }
    },
    "reason": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
