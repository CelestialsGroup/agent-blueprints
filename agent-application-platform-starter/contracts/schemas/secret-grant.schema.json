{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-platform:secret-grant:v1",
  "title": "SecretGrant",
  "description": "Immutable least-privilege grant for one execution operation to ask Credential Gateway for short-lived mediated material.",
  "type": "object",
  "required": [
    "secret_grant_id", "secret_grant_digest", "tenant_id", "principal_context_digest",
    "execution_scope", "provider_instance_id", "provider_revision_id", "provider_audience",
    "workload_identity", "secret_reference_ids", "purpose", "target",
    "operation", "target_request_contract_id", "target_request_digest_profile", "target_request_digest",
    "sender_constraint", "issued_at", "expires_at", "max_uses", "persistence_policy"
  ],
  "properties": {
    "secret_grant_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "secret_grant_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "tenant_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "principal_context_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "execution_scope": { "$ref": "urn:agent-platform:execution-scope:v1" },
    "provider_instance_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "provider_revision_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "provider_audience": { "type": "string", "pattern": "^urn:agent-platform:provider-instance:[A-Za-z0-9._:-]{1,200}$" },
    "workload_identity": { "type": "string", "minLength": 1, "maxLength": 500 },
    "secret_reference_ids": {
      "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 200 }
    },
    "purpose": { "enum": ["process_environment", "file_mount", "http_header"] },
    "target": {
      "type": "object",
      "required": ["target_kind", "target_id", "target_digest"],
      "properties": {
        "target_kind": { "enum": ["sandbox_exec", "capability_invocation"] },
        "target_id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "target_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "operation": { "const": "credential_access" },
    "target_request_contract_id": { "type": "string", "minLength": 1, "maxLength": 500 },
    "target_request_digest_profile": {
      "enum": [
        "rfc8785-sandbox-exec-intent-excluding-secret-grant-and-request-digest-v1",
        "rfc8785-capability-intent-excluding-secret-grant-and-request-digest-v1"
      ]
    },
    "target_request_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "sender_constraint": {
      "type": "object",
      "required": ["method", "subject"],
      "properties": {
        "method": { "enum": ["mtls_spiffe", "dpop"] },
        "subject": { "type": "string", "minLength": 1, "maxLength": 500 }
      },
      "additionalProperties": false
    },
    "issued_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "max_uses": { "const": 1 },
    "persistence_policy": {
      "type": "object",
      "required": ["provider_cache_allowed", "provider_persistence_allowed", "platform_event_material_allowed", "temporal_history_material_allowed"],
      "properties": {
        "provider_cache_allowed": { "const": false },
        "provider_persistence_allowed": { "const": false },
        "platform_event_material_allowed": { "const": false },
        "temporal_history_material_allowed": { "const": false }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "x-semantic-constraints": [
    "secret_grant_digest is RFC 8785 JCS SHA-256 over the grant excluding secret_grant_digest",
    "expires_at is later than issued_at and no more than 300 seconds later or the bound operation deadline, whichever is earlier",
    "execution scope, Tenant, Principal, ProviderRevision, workload identity, target and pre-grant operation-intent digest all match the admitted operation without a digest cycle",
    "sender_constraint subject equals the authenticated caller and the single use is consumed atomically before material delivery",
    "secret material, decrypted payload and delivery response are forbidden from Provider cache or persistence, Platform database, Event, log, trace, Recording and Temporal History",
    "revocation, expiration, consumed grant, identity mismatch or unavailable audit sink fails closed before material release"
  ]
}
