{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-platform:provider-admission-decision:v1",
  "title": "ProviderAdmissionDecision",
  "type": "object",
  "required": [
    "decision_id",
    "provider_revision_id",
    "provider_revision_digest",
    "decision_sequence",
    "decision",
    "evidence_digest",
    "decided_by",
    "decided_at",
    "decision_digest"
  ],
  "properties": {
    "decision_id": { "type": "string", "minLength": 1 },
    "provider_revision_id": { "type": "string", "minLength": 1 },
    "provider_revision_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "decision_sequence": { "type": "integer", "minimum": 1 },
    "decision": { "enum": ["certified", "revoked"] },
    "reason": { "type": "string", "minLength": 1 },
    "evidence_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "decided_by": { "type": "string", "minLength": 1 },
    "decided_at": { "type": "string", "format": "date-time" },
    "supersedes_decision_id": { "type": "string", "minLength": 1 },
    "decision_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": { "decision": { "const": "revoked" } },
        "required": ["decision"]
      },
      "then": { "required": ["reason", "supersedes_decision_id"] }
    },
    {
      "if": {
        "properties": { "decision_sequence": { "minimum": 2 } },
        "required": ["decision_sequence"]
      },
      "then": { "required": ["supersedes_decision_id"] }
    },
    {
      "if": {
        "properties": { "decision_sequence": { "const": 1 } },
        "required": ["decision_sequence"]
      },
      "then": { "not": { "required": ["supersedes_decision_id"] } }
    }
  ],
  "x-semantic-constraints": [
    "decisions are append-only; per ProviderRevision sequence starts at one, is contiguous, and supersedes_decision_id binds the immediately preceding decision",
    "decision_digest is RFC 8785 SHA-256 over the decision excluding decision_digest",
    "a Run may start only when the latest effective decision is certified"
  ]
}
