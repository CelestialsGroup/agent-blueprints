{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-platform:idempotency-record:v1",
  "title": "IdempotencyRecord",
  "type": "object",
  "required": [
    "tenant_id",
    "client_app_id",
    "operation_id",
    "idempotency_key_digest",
    "request_digest",
    "status",
    "created_at"
  ],
  "properties": {
    "tenant_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "client_app_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "operation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "idempotency_key_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "request_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "status": {
      "enum": [
        "processing",
        "completed",
        "failed"
      ]
    },
    "work_order_id": {
      "type": "string"
    },
    "response_reference": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false,
  "x-semantic-constraints": [
    "the unique idempotency scope is tenant_id plus client_app_id plus operation_id plus idempotency_key_digest",
    "the same scoped key with a different request_digest is rejected as a conflict and never re-executed"
  ]
}
