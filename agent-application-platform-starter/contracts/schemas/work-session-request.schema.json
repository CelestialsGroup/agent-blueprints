{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-platform:work-session-request:v1",
  "title": "CreateWorkSessionRequest",
  "type": "object",
  "required": [
    "subject_mode",
    "external_principal_id",
    "principal_context",
    "scopes",
    "ttl_seconds",
    "commercial_authorization"
  ],
  "properties": {
    "external_principal_id": {
      "type": "string"
    },
    "principal_context": {
      "$ref": "urn:agent-platform:principal-context-snapshot:v1"
    },
    "scopes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "work:read",
          "work:cancel",
          "event:subscribe",
          "artifact:read",
          "artifact:edit",
          "artifact:export",
          "work:control",
          "conversation:read",
          "conversation:write",
          "catalog:read",
          "approval:read",
          "approval:decide",
          "runtime:view",
          "runtime:control",
          "recording:read"
        ]
      }
    },
    "ttl_seconds": {
      "type": "integer",
      "minimum": 60,
      "maximum": 3600
    },
    "subject_mode": {
      "enum": [
        "owner",
        "delegated"
      ]
    },
    "delegation_reason": {
      "type": "string",
      "maxLength": 512
    },
    "commercial_authorization": {
      "$ref": "urn:agent-platform:commercial-authorization-snapshot:v1"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "subject_mode": {
            "const": "delegated"
          }
        }
      },
      "then": {
        "properties": {
          "delegation_reason": {
            "type": "string",
            "maxLength": 512
          }
        },
        "required": [
          "delegation_reason"
        ]
      }
    }
  ],
  "x-semantic-constraints": [
    "owner external_principal_id must equal the WorkOrder principal",
    "delegated mode requires ServiceOAuth scope session:delegate and Conversation collaboration policy",
    "the session cannot outlive commercial_authorization.expires_at or principal_context.expires_at",
    "principal_context external_principal_id matches the requested subject and client_app_id comes from authenticated service context"
  ]
}
