{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-platform:sandbox-desired-state-request:v1",
  "title": "SetSandboxDesiredStateRequest",
  "allOf": [
    {
      "$ref": "urn:agent-platform:sandbox-mutation-envelope:v1"
    },
    {
      "type": "object",
      "required": [
        "expected_generation",
        "desired_state"
      ],
      "properties": {
        "expected_generation": {
          "type": "integer",
          "minimum": 1
        },
        "desired_state": {
          "enum": [
            "ready",
            "suspended"
          ]
        },
        "reason": {
          "type": "string"
        }
      }
    }
  ],
  "unevaluatedProperties": false
}
