{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-platform:sandbox-desired-state-request:v1",
  "title": "SetSandboxDesiredStateRequest",
  "type": "object",
  "required": [
    "operation_id",
    "attempt_id",
    "fencing_token",
    "idempotency_key",
    "expected_generation",
    "desired_state"
  ],
  "properties": {
    "operation_id": {
      "type": "string"
    },
    "attempt_id": {
      "type": "string"
    },
    "fencing_token": {
      "type": "integer",
      "minimum": 1
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 16
    },
    "expected_generation": {
      "type": "integer",
      "minimum": 1
    },
    "desired_state": {
      "enum": [
        "ready",
        "suspended"
      ]
    },
    "reason": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
