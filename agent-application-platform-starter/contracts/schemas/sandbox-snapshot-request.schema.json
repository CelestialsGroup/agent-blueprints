{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-platform:sandbox-snapshot-request:v1",
  "title": "CreateSandboxSnapshotRequest",
  "allOf": [
    {
      "$ref": "urn:agent-platform:sandbox-mutation-envelope:v1"
    },
    {
      "type": "object",
      "required": [
        "expected_generation",
        "level",
        "consistency"
      ],
      "properties": {
        "expected_generation": {
          "type": "integer",
          "minimum": 1
        },
        "level": {
          "enum": [
            "workspace",
            "filesystem",
            "process"
          ]
        },
        "consistency": {
          "enum": [
            "crash_consistent",
            "application_quiesced"
          ]
        },
        "compatibility_profile": { "type": "string", "minLength": 1, "maxLength": 200 },
        "include_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^/workspace(?:/.*)?$"
          }
        }
      }
    }
  ],
  "unevaluatedProperties": false,
  "x-semantic-constraints": [
    "compatibility_profile is required when the resulting snapshot is intended for any target other than the exact source ProviderRevision and runtime revision",
    "a snapshot request cannot declare itself portable or compatible; only a later Platform CompatibilityDecision backed by Suite evidence can do so"
  ]
}
