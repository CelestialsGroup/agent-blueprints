{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-platform:capability-invocation-request:v1",
  "title": "CapabilityInvocationRequest",
  "type": "object",
  "required": [
    "protocol_version", "tenant_id", "client_app_id", "principal_context_digest", "execution_scope",
    "invocation_id", "invocation_attempt_id", "fencing_token", "idempotency_key", "execution_owner_request_digest", "request_digest",
    "provider_resolution_id", "provider_instance_id", "provider_revision_id", "capability", "deadline_at",
    "input", "input_artifact_grants", "output_staging_grant", "commercial_authorization",
    "execution_budget", "policy_decision", "effective_permissions", "trace_context"
  ],
  "properties": {
    "protocol_version": { "const": "v1" },
    "tenant_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "client_app_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "principal_context_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "execution_scope": { "allOf": [
      { "$ref": "urn:agent-platform:execution-scope:v1" },
      { "not": { "properties": { "kind": { "const": "artifact_ingest" } }, "required": ["kind"] } }
    ] },
    "invocation_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "invocation_attempt_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "fencing_token": { "type": "integer", "minimum": 1 },
    "idempotency_key": { "type": "string", "minLength": 16, "maxLength": 500 },
    "execution_owner_request_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "request_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "provider_resolution_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "provider_instance_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "provider_revision_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "capability": {
      "type": "object",
      "required": ["id", "version", "input_schema_digest", "output_schema_digest"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "version": { "type": "string", "minLength": 1, "maxLength": 100 },
        "profile": { "type": ["string", "null"], "maxLength": 100 },
        "input_schema_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "output_schema_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "deadline_at": { "type": "string", "format": "date-time" },
    "input": { "type": "object", "maxProperties": 256 },
    "secret_reference_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 200 }
    },
    "secret_grant_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "secret_grant_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "input_artifact_grants": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": { "$ref": "urn:agent-platform:artifact-grant:v1" }
    },
    "output_staging_grant": { "$ref": "urn:agent-platform:artifact-staging-grant:v1" },
    "commercial_authorization": { "$ref": "urn:agent-platform:commercial-authorization-binding:v1" },
    "execution_budget": { "$ref": "urn:agent-platform:execution-budget:v1" },
    "policy_decision": { "$ref": "urn:agent-platform:policy-decision:v1" },
    "effective_permissions": { "$ref": "urn:agent-platform:effective-permissions:v1" },
    "trace_context": {
      "type": "object",
      "required": ["traceparent"],
      "properties": {
        "traceparent": { "type": "string", "minLength": 1, "maxLength": 512 },
        "tracestate": { "type": "string", "maxLength": 1024 }
      },
      "additionalProperties": false
    }
  },
  "dependentRequired": {
    "secret_reference_ids": ["secret_grant_id", "secret_grant_digest"],
    "secret_grant_id": ["secret_reference_ids", "secret_grant_digest"],
    "secret_grant_digest": ["secret_reference_ids", "secret_grant_id"]
  },
  "additionalProperties": false,
  "x-semantic-constraints": [
    "request_digest is RFC 8785 JCS SHA-256 over the request excluding request_digest",
    "execution_owner_request_digest binds the immutable WorkOrder admission request through RunManifest or the ArtifactOperation client request without becoming Provider-owned truth",
    "input validates against the immutable admitted CapabilityDefinition input schema digest before dispatch",
    "the request ProviderResolution, ProviderInstance, ProviderRevision and bearer audience exactly match the admitted immutable resolution before execution",
    "execution_budget, policy_decision and effective_permissions carry complete executable values, close over the same Tenant, execution_scope and CommercialAuthorization, and their self-digests match the operation token",
    "the operation-scoped Capability token matches Tenant, ClientApplication, Principal context, execution_scope, ProviderResolution, ProviderRevision, InvocationAttempt, Fencing, request digest, policy, budget, permissions and StagingGrant",
    "every input ArtifactGrant and the output ArtifactStagingGrant bind the same Tenant, execution_scope and InvocationAttempt, do not outlive the request or CommercialAuthorization, and every read, upload or commit requires a separately refreshed Artifact Gateway token",
    "when secret references are present, the exact SecretGrant binds the pre-grant Capability intent digest, Tenant, Principal, execution_scope, ProviderRevision, workload identity and request deadline; material is obtained only through a single-operation Credential Gateway token"
  ]
}
