{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-platform:capability-invocation-request:v1",
  "title": "CapabilityInvocationRequest",
  "type": "object",
  "required": [
    "protocol_version", "tenant_id", "client_app_id", "principal_context_digest", "work_order_id",
    "invocation_id", "invocation_attempt_id", "fencing_token", "idempotency_key", "request_digest",
    "provider_resolution_id", "provider_instance_id", "provider_revision_id", "capability", "deadline_at",
    "input", "input_artifact_grants", "output_staging_grant", "commercial_authorization",
    "execution_budget", "policy_decision", "effective_permissions", "trace_context"
  ],
  "properties": {
    "protocol_version": { "const": "v1" },
    "tenant_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "client_app_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "principal_context_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "work_order_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "invocation_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "invocation_attempt_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "fencing_token": { "type": "integer", "minimum": 1 },
    "idempotency_key": { "type": "string", "minLength": 16, "maxLength": 500 },
    "request_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "provider_resolution_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "provider_instance_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "provider_revision_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "capability": {
      "type": "object",
      "required": ["id", "version", "input_schema_digest", "output_schema_digest"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "version": { "type": "string", "minLength": 1, "maxLength": 100 },
        "profile": { "type": ["string", "null"], "maxLength": 100 },
        "input_schema_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "output_schema_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "deadline_at": { "type": "string", "format": "date-time" },
    "input": { "type": "object", "maxProperties": 256 },
    "input_artifact_grants": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": { "$ref": "urn:agent-platform:artifact-grant:v1" }
    },
    "output_staging_grant": { "$ref": "urn:agent-platform:artifact-staging-grant:v1" },
    "commercial_authorization": { "$ref": "urn:agent-platform:commercial-authorization-binding:v1" },
    "execution_budget": { "$ref": "urn:agent-platform:execution-budget:v1" },
    "policy_decision": { "$ref": "urn:agent-platform:policy-decision:v1" },
    "effective_permissions": { "$ref": "urn:agent-platform:effective-permissions:v1" },
    "trace_context": {
      "type": "object",
      "required": ["traceparent"],
      "properties": {
        "traceparent": { "type": "string", "minLength": 1, "maxLength": 512 },
        "tracestate": { "type": "string", "maxLength": 1024 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "x-semantic-constraints": [
    "request_digest is RFC 8785 JCS SHA-256 over the request excluding request_digest",
    "input validates against the immutable admitted CapabilityDefinition input schema digest before dispatch",
    "the request ProviderResolution, ProviderInstance, ProviderRevision and bearer audience exactly match the admitted immutable resolution before execution",
    "execution_budget, policy_decision and effective_permissions carry complete executable values, close over the same Tenant, WorkOrder and CommercialAuthorization, and their self-digests match the operation token",
    "the operation-scoped Capability token matches Tenant, ClientApplication, Principal context, WorkOrder, ProviderResolution, ProviderRevision, InvocationAttempt, Fencing, request digest, policy, budget, permissions and StagingGrant",
    "every input ArtifactGrant and the output ArtifactStagingGrant bind the same Tenant, WorkOrder and InvocationAttempt, do not outlive the request or CommercialAuthorization, and every read, upload or commit requires a separately refreshed Artifact Gateway token"
  ]
}
