{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-platform:conversation-branch-create-request:v1",
  "title": "ConversationBranchCreateRequest",
  "description": "Idempotent empty-branch creation or immutable fork at an explicit message and WorkspaceRevision cut.",
  "type": "object",
  "required": ["branch_request_id", "conversation_id", "branch_id", "mode", "idempotency_key", "request_digest"],
  "properties": {
    "branch_request_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "conversation_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "branch_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "mode": { "enum": ["create", "fork"] },
    "source_branch_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "source_message_id": { "type": ["string", "null"], "maxLength": 200 },
    "source_message_sequence": { "type": "integer", "minimum": 0 },
    "source_message_head_version": { "type": "integer", "minimum": 1 },
    "source_workspace_revision_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "source_workspace_revision_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "source_workspace_head_version": { "type": "integer", "minimum": 1 },
    "idempotency_key": { "type": "string", "minLength": 16, "maxLength": 255 },
    "request_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "mode": { "const": "fork" } }, "required": ["mode"] },
      "then": {
        "required": [
          "source_branch_id", "source_message_id", "source_message_sequence", "source_message_head_version",
          "source_workspace_revision_id", "source_workspace_revision_digest", "source_workspace_head_version"
        ]
      },
      "else": {
        "not": {
          "anyOf": [
            { "required": ["source_branch_id"] }, { "required": ["source_message_id"] },
            { "required": ["source_message_sequence"] }, { "required": ["source_message_head_version"] },
            { "required": ["source_workspace_revision_id"] }, { "required": ["source_workspace_revision_digest"] },
            { "required": ["source_workspace_head_version"] }
          ]
        }
      }
    },
    {
      "if": { "properties": { "source_message_sequence": { "const": 0 } }, "required": ["source_message_sequence"] },
      "then": { "properties": { "source_message_id": { "type": "null" } } }
    },
    {
      "if": { "properties": { "source_message_sequence": { "minimum": 1 } }, "required": ["source_message_sequence"] },
      "then": { "properties": { "source_message_id": { "type": "string", "minLength": 1 } } }
    }
  ],
  "x-semantic-constraints": [
    "request_digest is RFC 8785 JCS SHA-256 over the request excluding request_digest",
    "idempotency scope is Tenant-derived ClientApplication plus conversation plus branch-create plus idempotency-key digest",
    "fork source message is the exact immutable cut on source_branch_id and source_message_head_version prevents a moving-head interpretation",
    "fork source WorkspaceRevision is the exact source head at source_workspace_head_version and its digest must verify before the new branch is inserted",
    "branch identity, initial heads and branch-created or branch-forked Outbox event are committed atomically; a digest conflict returns 409",
    "conversation_id exactly equals the authenticated Agent Access path parameter before source cuts are resolved or the branch is inserted"
  ]
}
