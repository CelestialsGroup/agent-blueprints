{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-platform:sandbox-exec-request:v1",
  "title": "SandboxExecRequest",
  "allOf": [
    {
      "$ref": "urn:agent-platform:sandbox-mutation-envelope:v1"
    },
    {
      "type": "object",
      "required": [
        "expected_generation",
        "command",
        "working_directory"
      ],
      "properties": {
        "expected_generation": {
          "type": "integer",
          "minimum": 1
        },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "working_directory": {
          "type": "string",
          "pattern": "^/workspace(?:/.*)?$"
        },
        "environment": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "secret_reference_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "secret_grant_id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "secret_grant_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "stdin_reference": {
          "type": "string"
        },
        "capture": {
          "type": "object",
          "properties": {
            "stdout": {
              "type": "boolean"
            },
            "stderr": {
              "type": "boolean"
            },
            "max_bytes": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        }
      },
      "dependentRequired": {
        "secret_reference_ids": ["secret_grant_id", "secret_grant_digest"],
        "secret_grant_id": ["secret_reference_ids", "secret_grant_digest"],
        "secret_grant_digest": ["secret_reference_ids", "secret_grant_id"]
      }
    }
  ],
  "unevaluatedProperties": false,
  "x-semantic-constraints": [
    "plain-text secret values are forbidden and every secret_reference_id is covered by the exact immutable SecretGrant",
    "SecretGrant Tenant, Principal, execution_scope, ProviderRevision, workload identity, sandbox-exec target and pre-grant request-intent digest match this operation",
    "Credential Gateway delivery is single-operation, short-lived, sender-constrained, audited and never cached or persisted by Sandbox or Runtime",
    "command executes inside the selected Sandbox generation"
  ]
}
