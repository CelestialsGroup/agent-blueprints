{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-platform:sandbox-exec-request:v1",
  "title": "SandboxExecRequest",
  "allOf": [
    {
      "$ref": "urn:agent-platform:sandbox-mutation-envelope:v1"
    },
    {
      "type": "object",
      "required": [
        "expected_generation",
        "command",
        "working_directory"
      ],
      "properties": {
        "expected_generation": {
          "type": "integer",
          "minimum": 1
        },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "working_directory": {
          "type": "string",
          "pattern": "^/workspace(?:/.*)?$"
        },
        "environment": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "secret_reference_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "stdin_reference": {
          "type": "string"
        },
        "capture": {
          "type": "object",
          "properties": {
            "stdout": {
              "type": "boolean"
            },
            "stderr": {
              "type": "boolean"
            },
            "max_bytes": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        }
      }
    }
  ],
  "unevaluatedProperties": false,
  "x-semantic-constraints": [
    "plain-text secret values are forbidden",
    "command executes inside the selected Sandbox generation"
  ]
}
