{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-platform:sandbox-runtime-session-open-request:v1",
  "title": "OpenSandboxRuntimeSessionRequest",
  "allOf": [
    {
      "$ref": "urn:agent-platform:sandbox-mutation-envelope:v1"
    },
    {
      "type": "object",
      "required": [
        "expected_generation",
        "runtime_session_id",
        "runtime_type",
        "scopes",
        "expires_at"
      ],
      "properties": {
        "expected_generation": {
          "type": "integer",
          "minimum": 1
        },
        "runtime_session_id": {
          "type": "string"
        },
        "runtime_type": {
          "enum": [
            "terminal",
            "browser",
            "desktop",
            "port_forward"
          ]
        },
        "scopes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "target_port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  ],
  "unevaluatedProperties": false
}
