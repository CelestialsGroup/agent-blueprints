{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-platform:child-agent-run-spawn-request:v1",
  "title": "ChildAgentRunSpawnRequest",
  "description": "Provider-originated, platform-governed request to create one child AgentRun. It requests capabilities and isolation but cannot choose a ProviderRevision or allocate a Platform identity.",
  "type": "object",
  "required": [
    "spawn_request_id", "request_digest", "tenant_id", "work_order_id", "workflow_run_id",
    "root_agent_run_id", "parent_agent_run_id", "parent_runtime_run_id", "parent_run_depth",
    "requested_agent_role", "required_for_work_order_completion", "delegated_input",
    "required_capabilities", "workspace_mode", "sandbox_mode", "requested_at"
  ],
  "properties": {
    "spawn_request_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "request_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "tenant_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "work_order_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "workflow_run_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "root_agent_run_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "parent_agent_run_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "parent_runtime_run_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "parent_run_depth": { "type": "integer", "minimum": 0, "maximum": 63 },
    "requested_agent_role": { "type": "string", "minLength": 1, "maxLength": 128 },
    "required_for_work_order_completion": { "type": "boolean" },
    "delegated_input": { "$ref": "urn:agent-platform:runtime-input-envelope:v1" },
    "required_capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["id", "version"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 200 },
          "version": { "type": "string", "minLength": 1, "maxLength": 100 },
          "profile": { "type": ["string", "null"], "maxLength": 100 }
        },
        "additionalProperties": false
      }
    },
    "workspace_mode": {
      "enum": ["read_only_parent_revision", "isolated_revision", "shared_branch_cas"]
    },
    "sandbox_mode": { "enum": ["none", "dedicated"] },
    "requested_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false,
  "x-semantic-constraints": [
    "request_digest is RFC 8785 JCS SHA-256 over the request excluding request_digest",
    "delegated_input uses source_kind delegated_task and its child_agent_spawn_request_id equals spawn_request_id",
    "parent Runtime identity resolves to the same immutable parent and root AgentRun in the same Tenant, WorkOrder and WorkflowRun",
    "the Provider may request capabilities, role and isolation but cannot choose AgentRun identity, ProviderRevision, Sandbox identity, budget allocation or admission outcome",
    "repeated spawn_request_id plus request_digest is idempotent; a different digest conflicts and no child is created"
  ]
}
