{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-platform:conversion-job:v1",
  "title": "ConversionJob",
  "type": "object",
  "required": [
    "conversion_job_id",
    "source_artifact_id",
    "source_version_id",
    "target_media_type",
    "status",
    "created_at"
  ],
  "properties": {
    "conversion_job_id": {
      "type": "string"
    },
    "source_artifact_id": {
      "type": "string"
    },
    "source_version_id": {
      "type": "string"
    },
    "target_media_type": {
      "type": "string"
    },
    "profile": {
      "type": "string"
    },
    "status": {
      "enum": [
        "queued",
        "running",
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "result_artifact_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
