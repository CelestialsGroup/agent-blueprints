{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-platform:plugin-invocation-token-claims:v1",
  "title": "PluginInvocationTokenClaims",
  "type": "object",
  "required": [
    "jti",
    "iss",
    "aud",
    "iat",
    "nbf",
    "exp",
    "plugin_id",
    "provider_revision_id",
    "invocation_id",
    "invocation_attempt_id",
    "fencing_token",
    "capability_id",
    "capability_version",
    "staging_session_id",
    "permissions_digest"
  ],
  "properties": {
    "jti": {
      "type": "string"
    },
    "iss": {
      "const": "agent-platform"
    },
    "aud": {
      "type": "string"
    },
    "iat": {
      "type": "integer",
      "minimum": 0
    },
    "nbf": {
      "type": "integer",
      "minimum": 0
    },
    "exp": {
      "type": "integer",
      "minimum": 0
    },
    "plugin_id": {
      "type": "string"
    },
    "provider_revision_id": {
      "type": "string"
    },
    "invocation_id": {
      "type": "string"
    },
    "invocation_attempt_id": {
      "type": "string"
    },
    "fencing_token": {
      "type": "integer",
      "minimum": 1
    },
    "capability_id": {
      "type": "string"
    },
    "capability_version": {
      "type": "string"
    },
    "staging_session_id": {
      "type": "string"
    },
    "permissions_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "additionalProperties": false,
  "x-semantic-constraints": [
    "iat < exp",
    "exp - iat <= 900"
  ]
}
