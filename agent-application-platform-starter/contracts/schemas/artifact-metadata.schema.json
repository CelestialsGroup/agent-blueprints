{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-platform:artifact-metadata:v1",
  "title": "ArtifactMetadata",
  "type": "object",
  "required": [
    "artifact_id",
    "tenant_id",
    "workspace_id",
    "name",
    "current_version_id",
    "capabilities",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "artifact_id": {
      "type": "string"
    },
    "tenant_id": {
      "type": "string"
    },
    "workspace_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "current_version_id": {
      "type": "string"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "enum": [
          "preview",
          "native-edit",
          "source-edit",
          "structural-edit",
          "annotation-edit",
          "metadata-edit",
          "read-only"
        ]
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
