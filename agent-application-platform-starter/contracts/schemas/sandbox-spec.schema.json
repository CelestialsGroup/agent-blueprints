{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-platform:sandbox-spec:v1",
  "title": "SandboxSpec",
  "type": "object",
  "required": [
    "sandbox_id",
    "tenant_id",
    "work_order_id",
    "workspace_id",
    "branch_id",
    "provider_resolution_id",
    "provider_revision_id",
    "image",
    "runtime_profile",
    "resources",
    "required_capabilities",
    "network",
    "workspace",
    "lease",
    "security",
    "sandbox_slot_key"
  ],
  "properties": {
    "sandbox_id": {
      "type": "string"
    },
    "tenant_id": {
      "type": "string"
    },
    "work_order_id": {
      "type": "string"
    },
    "workspace_id": {
      "type": "string"
    },
    "branch_id": { "type": "string", "minLength": 1 },
    "provider_resolution_id": { "type": "string", "minLength": 1 },
    "provider_revision_id": {
      "type": "string"
    },
    "image": {
      "type": "object",
      "required": [
        "reference",
        "digest"
      ],
      "properties": {
        "reference": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "architecture": {
          "enum": [
            "amd64",
            "arm64"
          ]
        }
      },
      "additionalProperties": false
    },
    "runtime_profile": {
      "type": "string"
    },
    "resources": {
      "type": "object",
      "required": [
        "cpu_millis",
        "memory_bytes",
        "ephemeral_storage_bytes",
        "pids_limit"
      ],
      "properties": {
        "cpu_millis": {
          "type": "integer",
          "minimum": 1
        },
        "memory_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "ephemeral_storage_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "workspace_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "gpu_count": {
          "type": "integer",
          "minimum": 0
        },
        "pids_limit": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "required_capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "id",
          "version"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "profile": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "optional_capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "id",
          "version"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "profile": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "network": {
      "type": "object",
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "none",
            "restricted",
            "full"
          ]
        },
        "policy_reference": {
          "type": "string"
        },
        "egress_gateway_required": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "workspace": {
      "type": "object",
      "required": [
        "mode",
        "base_revision_id",
        "base_revision_digest",
        "base_workspace_head_version",
        "commit_mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "ephemeral",
            "persistent"
          ]
        },
        "base_revision_id": { "type": "string", "minLength": 1 },
        "base_revision_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "base_workspace_head_version": { "type": "integer", "minimum": 1 },
        "commit_mode": { "enum": ["read_only", "cas_new_revision"] },
        "snapshot_reference": { "type": "string" },
        "mount_path": {
          "const": "/workspace"
        }
      },
      "additionalProperties": false
    },
    "lease": {
      "type": "object",
      "required": [
        "expires_at",
        "max_extension_seconds"
      ],
      "properties": {
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "max_extension_seconds": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "placement_constraints": {
      "type": "object",
      "properties": {
        "region_id": {
          "type": "string"
        },
        "resource_class": {
          "enum": [
            "standard",
            "browser",
            "office",
            "video",
            "gpu"
          ]
        },
        "architecture": {
          "enum": [
            "amd64",
            "arm64"
          ]
        }
      },
      "additionalProperties": false
    },
    "security": {
      "type": "object",
      "required": [
        "privilege_level",
        "root_filesystem",
        "service_account_mode",
        "allow_privilege_escalation",
        "host_namespace_access"
      ],
      "properties": {
        "privilege_level": {
          "const": "unprivileged"
        },
        "root_filesystem": {
          "enum": [
            "read_only",
            "writable_overlay"
          ]
        },
        "service_account_mode": {
          "enum": [
            "none",
            "restricted"
          ]
        },
        "allow_privilege_escalation": {
          "const": false
        },
        "host_namespace_access": {
          "const": false
        },
        "seccomp_profile": {
          "enum": [
            "runtime-default",
            "localhost-profile"
          ]
        }
      },
      "additionalProperties": false
    },
    "labels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "sandbox_slot_key": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9/_-]{0,127}$",
      "description": "Logical Sandbox purpose inside a Workspace, e.g. primary-code or subagent/research-01."
    },
    "agent_run_id": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "x-semantic-constraints": [
    "restricted network requires policy_reference and egress_gateway_required=true",
    "full network requires explicit platform policy approval",
    "resources and lease must not exceed provider capabilities or ExecutionBudget",
    "workspace base revision matches the WorkOrder branch head admitted into RunManifest",
    "cas_new_revision creates a new immutable WorkspaceRevision and advances the branch head only by compare-and-swap"
  ]
}
