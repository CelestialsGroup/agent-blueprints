{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-platform:sandbox-reconciliation-case:v1",
  "title": "SandboxReconciliationCase",
  "type": "object",
  "required": [
    "case_id", "operation_id", "attempt_id", "status", "deadline_at",
    "opened_at", "updated_at", "evidence_references"
  ],
  "properties": {
    "case_id": { "type": "string", "minLength": 1 },
    "operation_id": { "type": "string", "minLength": 1 },
    "attempt_id": { "type": "string", "minLength": 1 },
    "status": { "enum": ["open", "querying", "manual_review", "resolved"] },
    "deadline_at": { "type": "string", "format": "date-time" },
    "evidence_references": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "resolved_outcome": { "enum": ["succeeded", "failed", "abandoned"] },
    "opened_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "resolved_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "resolved" } }, "required": ["status"] },
      "then": { "required": ["resolved_outcome", "resolved_at"] }
    }
  ]
}
