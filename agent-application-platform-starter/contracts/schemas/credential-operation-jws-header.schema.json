{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-platform:credential-operation-jws-header:v1",
  "title": "CredentialOperationJwsHeader",
  "type": "object",
  "required": ["alg", "kid", "typ"],
  "properties": {
    "alg": { "enum": ["EdDSA", "ES256"] },
    "kid": { "type": "string", "minLength": 1, "maxLength": 200 },
    "typ": { "const": "agent-credential-operation+jwt" }
  },
  "additionalProperties": false
}
