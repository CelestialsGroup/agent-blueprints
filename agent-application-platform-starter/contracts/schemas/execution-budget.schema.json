{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-platform:execution-budget:v1",
  "title": "ExecutionBudget",
  "type": "object",
  "required": [
    "budget_id",
    "budget_digest",
    "tenant_id",
    "execution_scope",
    "limits",
    "policies",
    "created_at",
    "expires_at"
  ],
  "properties": {
    "budget_id": {
      "type": "string",
      "minLength": 1
    },
    "budget_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "execution_scope": { "$ref": "urn:agent-platform:execution-scope:v1" },
    "limits": { "$ref": "urn:agent-platform:effective-execution-limits:v1" },
    "policies": {
      "type": "object",
      "required": [
        "model_gateway_required",
        "tool_gateway_required",
        "egress_gateway_required"
      ],
      "properties": {
        "model_gateway_required": {
          "type": "boolean"
        },
        "tool_gateway_required": {
          "type": "boolean"
        },
        "egress_gateway_required": {
          "type": "boolean"
        },
        "external_communication": {
          "type": "boolean"
        },
        "require_approval_for": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "data_classification": {
          "enum": [
            "public",
            "internal",
            "confidential",
            "restricted"
          ]
        }
      },
      "additionalProperties": false
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false,
  "x-semantic-constraints": [
    "budget_digest is RFC 8785 JCS SHA-256 over the budget excluding budget_digest",
    "the budget is immutable, tenant-qualified, bound to exactly one WorkOrder, ArtifactOperation or ArtifactIngestSession, and expires after created_at"
  ]
}
