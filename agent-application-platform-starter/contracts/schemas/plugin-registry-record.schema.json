{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-platform:plugin-registry-record:v1",
  "title": "PluginRegistryRecord",
  "type": "object",
  "required": [
    "plugin_id",
    "plugin_version",
    "manifest_digest",
    "trust_level",
    "verification_status",
    "approved_permissions",
    "signature_status",
    "scan_status",
    "installed_at"
  ],
  "properties": {
    "plugin_id": {
      "type": "string"
    },
    "plugin_version": {
      "type": "string"
    },
    "manifest_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "image_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "trust_level": {
      "enum": [
        "official",
        "verified",
        "private",
        "untrusted"
      ]
    },
    "verification_status": {
      "enum": [
        "pending",
        "passed",
        "failed"
      ]
    },
    "approved_permissions": {
      "type": "object",
      "properties": {
        "network": {
          "type": "object",
          "properties": {
            "outbound": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "scheme",
                  "host"
                ],
                "properties": {
                  "scheme": {
                    "enum": [
                      "https",
                      "http",
                      "tcp"
                    ]
                  },
                  "host": {
                    "type": "string"
                  },
                  "port": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 65535
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "artifacts": {
          "type": "object",
          "properties": {
            "read_roles": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "write_staging": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "secrets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "purpose"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "purpose": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "sandbox": {
          "type": "object",
          "properties": {
            "terminal": {
              "type": "boolean"
            },
            "browser": {
              "type": "boolean"
            },
            "filesystem_write": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "signature_status": {
      "enum": [
        "verified",
        "missing",
        "invalid"
      ]
    },
    "scan_status": {
      "enum": [
        "pending",
        "passed",
        "failed"
      ]
    },
    "sbom_reference": {
      "type": "string"
    },
    "installed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
