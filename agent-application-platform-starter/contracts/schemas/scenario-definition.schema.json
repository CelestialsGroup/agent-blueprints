{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-platform:scenario-definition:v1",
  "title": "ScenarioDefinition",
  "type": "object",
  "required": [
    "api_version",
    "id",
    "version",
    "name",
    "input_schema",
    "workflow",
    "capabilities",
    "experience_requirements",
    "outputs",
    "lifecycle",
    "definition_digest"
  ],
  "properties": {
    "api_version": {
      "const": "agent-platform/scenario/v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{2,127}$"
    },
    "version": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "input_schema": {
      "type": "object",
      "required": [
        "uri",
        "digest",
        "dialect"
      ],
      "properties": {
        "uri": {
          "type": "string",
          "format": "uri"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "dialect": {
          "const": "https://json-schema.org/draft/2020-12/schema"
        }
      },
      "additionalProperties": false
    },
    "workflow": {
      "type": "object",
      "required": [
        "id",
        "version",
        "definition_digest"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "definition_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "capabilities": {
      "type": "object",
      "required": [
        "required",
        "optional"
      ],
      "properties": {
        "required": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "version_range"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "version_range": {
                "type": "string"
              },
              "required_profiles": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          }
        },
        "optional": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "version_range"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "version_range": {
                "type": "string"
              },
              "required_profiles": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "outputs": {
      "type": "object",
      "required": [
        "primary_media_type"
      ],
      "properties": {
        "primary_media_type": {
          "type": "string"
        },
        "optional_media_types": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "experience_requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "capability_id", "minimum", "maximum"],
        "properties": {
          "kind": { "enum": ["template", "skill_pack", "design_system", "editor_profile"] },
          "capability_id": { "type": "string", "minLength": 1 },
          "minimum": { "type": "integer", "minimum": 0 },
          "maximum": { "type": "integer", "minimum": 1 },
          "required_tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
        },
        "additionalProperties": false
      }
    },
    "resource_class": {
      "enum": [
        "standard",
        "browser",
        "office",
        "video",
        "gpu"
      ]
    },
    "ui": {
      "type": "object",
      "required": ["schema", "slots", "option_sources"],
      "properties": {
        "schema": { "$ref": "urn:agent-platform:schema-reference:v1" },
        "slots": {
          "type": "object",
          "propertyNames": { "pattern": "^[a-z][a-z0-9._-]{2,127}$" },
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "option_sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["field_pointer", "source", "kind", "capability_id"],
            "properties": {
              "field_pointer": { "type": "string", "pattern": "^/" },
              "source": { "const": "experience_catalog" },
              "kind": { "enum": ["template", "skill_pack", "design_system", "editor_profile"] },
              "capability_id": { "type": "string", "minLength": 1 },
              "required_tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "lifecycle": {
      "enum": ["experimental", "stable", "deprecated", "retired"]
    },
    "definition_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "additionalProperties": false,
  "x-semantic-constraints": [
    "UI option sources are catalog queries, never hard-coded Plugin IDs or arbitrary remote JavaScript",
    "experience selections satisfy minimum/maximum and capability/tag requirements",
    "definition_digest binds input, workflow, capabilities, experience requirements and UI schema"
  ]
}
