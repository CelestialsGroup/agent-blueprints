{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-platform:sandbox-operation-record:v2",
  "title": "SandboxOperationRecord",
  "type": "object",
  "required": ["operation_id", "logical_operation_key", "sandbox_id", "type", "status", "current_attempt_number", "max_attempts", "created_at", "updated_at"],
  "properties": {
    "operation_id": { "type": "string", "minLength": 1 },
    "logical_operation_key": { "type": "string", "minLength": 1 },
    "sandbox_id": { "type": "string", "minLength": 1 },
    "type": { "enum": ["create", "extend_lease", "exec", "cancel_exec", "snapshot", "restore", "suspend", "resume", "terminate", "open_runtime_session"] },
    "status": { "enum": ["pending", "running", "retry_scheduled", "cancel_requested", "reconciling", "manual_review_required", "cancellation_confirmed", "succeeded", "failed", "cancelled", "abandoned"] },
    "current_attempt_number": { "type": "integer", "minimum": 0 },
    "max_attempts": { "type": "integer", "minimum": 1 },
    "current_attempt_id": { "type": "string", "minLength": 1 },
    "next_retry_at": { "type": "string", "format": "date-time" },
    "reconciliation_case_id": { "type": "string", "minLength": 1 },
    "manual_review_decision_id": { "type": "string", "minLength": 1 },
    "cancellation_requested_at": { "type": "string", "format": "date-time" },
    "cancellation_intent": { "type": "boolean" },
    "cancellation_confirmation": { "$ref": "urn:agent-platform:cancellation-confirmation:v1" },
    "result_reference": { "type": "string", "minLength": 1 },
    "terminal_reason": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false,
  "allOf": [
    { "if": { "properties": { "status": { "const": "pending" } }, "required": ["status"] }, "then": { "properties": { "current_attempt_number": { "const": 0 } }, "not": { "required": ["current_attempt_id"] } } },
    { "if": { "properties": { "status": { "enum": ["running", "retry_scheduled", "cancel_requested", "reconciling", "manual_review_required", "cancellation_confirmed"] } }, "required": ["status"] }, "then": { "required": ["current_attempt_id"], "properties": { "current_attempt_number": { "minimum": 1 } } } },
    { "if": { "properties": { "status": { "const": "retry_scheduled" } }, "required": ["status"] }, "then": { "required": ["next_retry_at"] } },
    { "if": { "properties": { "status": { "const": "cancel_requested" } }, "required": ["status"] }, "then": { "required": ["cancellation_requested_at", "cancellation_intent"], "properties": { "cancellation_intent": { "const": true } } } },
    { "if": { "properties": { "status": { "enum": ["reconciling", "manual_review_required"] } }, "required": ["status"] }, "then": { "required": ["reconciliation_case_id"] } },
    { "if": { "properties": { "status": { "const": "cancellation_confirmed" } }, "required": ["status"] }, "then": { "required": ["cancellation_confirmation"] } },
    { "if": { "properties": { "status": { "const": "succeeded" } }, "required": ["status"] }, "then": { "required": ["result_reference", "completed_at"] } },
    { "if": { "properties": { "status": { "enum": ["failed", "abandoned"] } }, "required": ["status"] }, "then": { "required": ["terminal_reason", "completed_at"] } },
    { "if": { "properties": { "status": { "const": "cancelled" } }, "required": ["status"] }, "then": { "required": ["terminal_reason", "completed_at", "cancellation_confirmation"] } }
  ],
  "x-semantic-constraints": ["current_attempt_number must not exceed max_attempts"]
}
