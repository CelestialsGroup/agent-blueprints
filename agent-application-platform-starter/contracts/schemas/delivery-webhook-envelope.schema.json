{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-platform:delivery-webhook-envelope:v1",
  "title": "DeliveryWebhookEnvelope",
  "type": "object",
  "required": [
    "webhook_id",
    "event_type",
    "occurred_at",
    "delivery"
  ],
  "properties": {
    "webhook_id": {
      "type": "string"
    },
    "event_type": {
      "const": "delivery.completed"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "delivery": { "$ref": "urn:agent-platform:delivery-package:v1" }
  },
  "additionalProperties": false
}
