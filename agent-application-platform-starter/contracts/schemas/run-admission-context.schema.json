{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-platform:run-admission-context:v1",
  "title": "RunAdmissionContext",
  "type": "object",
  "required": ["scenario", "scenario_definition", "required_capabilities", "experience_requirements", "capability_definitions", "agent_runtime_capability", "provider_revisions", "admission_decisions", "experience_revisions", "commercial_authorization"],
  "properties": {
    "scenario": {
      "type": "object",
      "required": ["id", "version", "definition_digest"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "definition_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "scenario_definition": { "$ref": "urn:agent-platform:scenario-definition:v1" },
    "required_capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["id", "version", "profile"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "profile": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    },
    "experience_requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "capability_id", "minimum", "maximum"],
        "properties": {
          "kind": { "enum": ["template", "skill_pack", "design_system", "editor_profile"] },
          "capability_id": { "type": "string", "minLength": 1 },
          "minimum": { "type": "integer", "minimum": 0 },
          "maximum": { "type": "integer", "minimum": 1 },
          "required_tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
        },
        "additionalProperties": false
      }
    },
    "capability_definitions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "urn:agent-platform:admitted-capability-definition:v1" }
    },
    "agent_runtime_capability": { "$ref": "urn:agent-platform:admitted-capability-definition:v1" },
    "commercial_authorization": { "$ref": "urn:agent-platform:commercial-authorization-snapshot:v1" },
    "provider_revisions": { "type": "array", "minItems": 1, "items": { "$ref": "urn:agent-platform:provider-revision:v1" } },
    "admission_decisions": { "type": "array", "minItems": 1, "items": { "$ref": "urn:agent-platform:provider-admission-decision:v1" } }
    ,"experience_revisions": {
      "type": "array",
      "items": { "$ref": "urn:agent-platform:template-revision:v1" },
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
