{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-platform:run-admission-context:v1",
  "title": "RunAdmissionContext",
  "type": "object",
  "required": ["scenario", "required_capabilities", "provider_revisions", "admission_decisions"],
  "properties": {
    "scenario": {
      "type": "object",
      "required": ["id", "version", "definition_digest"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "definition_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "required_capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["id", "version", "profile"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "profile": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    },
    "provider_revisions": { "type": "array", "minItems": 1, "items": { "$ref": "urn:agent-platform:provider-revision:v1" } },
    "admission_decisions": { "type": "array", "minItems": 1, "items": { "$ref": "urn:agent-platform:provider-admission-decision:v1" } }
  },
  "additionalProperties": false
}
