{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-platform:conformance-suite-manifest:v1",
  "title": "ConformanceSuiteManifest",
  "description": "Immutable machine-readable test inventory required before a ProviderRevision or Gateway protocol may be certified.",
  "type": "object",
  "required": [
    "suite_id",
    "suite_version",
    "suite_digest",
    "target_kind",
    "profiles"
  ],
  "properties": {
    "suite_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{2,191}$"
    },
    "suite_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "suite_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "target_kind": {
      "enum": [
        "agent_runtime",
        "sandbox",
        "runtime_gateway"
        ,"capability_provider"
      ]
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "profile_id",
          "tests"
        ],
        "properties": {
          "profile_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{2,191}$"
          },
          "depends_on": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "tests": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "required": [
                "test_id",
                "category",
                "evidence_type",
                "description"
              ],
              "properties": {
                "test_id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_.-]{2,191}$"
                },
                "category": {
                  "enum": [
                    "contract",
                    "lifecycle",
                    "ordering",
                    "recovery",
                    "security",
                    "usage",
                    "recording",
                    "multi_node"
                  ]
                },
                "evidence_type": {
                  "enum": [
                    "test_log",
                    "trace",
                    "artifact",
                    "report"
                  ]
                },
                "description": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "x-semantic-constraints": [
    "suite_digest is RFC 8785 JCS SHA-256 over the suite excluding suite_digest",
    "profile_id and test_id are unique within the suite",
    "depends_on references profiles in the same suite without cycles",
    "every test execution emits immutable evidence bound to suite_version, ProviderRevision or Gateway build, environment and timestamp"
  ]
}
