{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-platform:plugin-cancellation-request:v1",
  "title": "PluginCancellationRequest",
  "type": "object",
  "required": [
    "invocation_id",
    "fencing_token",
    "reason",
    "invocation_attempt_id",
    "request_digest"
  ],
  "properties": {
    "invocation_id": {
      "type": "string"
    },
    "provider_operation_id": {
      "type": "string"
    },
    "fencing_token": {
      "type": "integer",
      "minimum": 1
    },
    "reason": {
      "type": "string"
    },
    "invocation_attempt_id": {
      "type": "string"
    },
    "request_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "additionalProperties": false,
  "x-semantic-constraints": [
    "request_digest is RFC 8785 JCS SHA-256 over the cancellation request excluding request_digest",
    "cancellation is idempotent intent and does not prove that the Plugin effect stopped before completion"
  ]
}
