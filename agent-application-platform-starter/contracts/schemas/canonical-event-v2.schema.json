{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-platform:canonical-event:v2",
  "title": "CanonicalEventV2",
  "type": "object",
  "required": [
    "event_id",
    "schema_version",
    "tenant_id",
    "producer_kind",
    "producer_id",
    "provider_revision_id",
    "source_stream_id",
    "source_event_id",
    "source_cursor",
    "dedupe_key",
    "event_registry",
    "conversation_id",
    "aggregate",
    "type",
    "occurred_at",
    "actor",
    "data",
    "metadata",
    "data_version",
    "recorded_at"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "schema_version": {
      "const": 2
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "producer_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "producer_kind": {
      "enum": ["platform", "provider"]
    },
    "provider_revision_id": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 200
    },
    "source_stream_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "source_event_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "source_cursor": {
      "type": ["string", "null"],
      "maxLength": 1000
    },
    "dedupe_key": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "event_registry": {
      "type": "object",
      "required": ["registry_id", "registry_version", "registry_digest"],
      "properties": {
        "registry_id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "registry_version": { "type": "integer", "minimum": 1 },
        "registry_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "conversation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "work_order_id": {
      "type": "string",
      "minLength": 1
    },
    "turn_id": {
      "type": "string",
      "minLength": 1
    },
    "branch_id": {
      "type": "string",
      "minLength": 1
    },
    "input_message_id": {
      "type": "string",
      "minLength": 1
    },
    "workspace_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "work_sequence": {
      "type": "integer",
      "minimum": 1
    },
    "aggregate": {
      "type": "object",
      "required": [
        "type",
        "id",
        "sequence"
      ],
      "properties": {
        "type": {
          "enum": [
            "work_order",
            "conversation",
            "conversation_branch",
            "conversation_message",
            "workspace_revision",
            "workflow_run",
            "agent_run",
            "invocation",
            "artifact",
            "edit_session",
            "conversion_job",
            "approval",
            "delivery",
            "sandbox",
            "sandbox_operation",
            "runtime_session",
            "runtime_recording"
          ]
        },
        "id": {
          "type": "string"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "description": "Aggregate-local sequence."
        }
      },
      "additionalProperties": false
    },
    "references": {
      "type": "object",
      "properties": {
        "workflow_run_id": {
          "type": "string"
        },
        "agent_run_id": {
          "type": "string"
        },
        "invocation_id": {
          "type": "string"
        },
        "artifact_id": {
          "type": "string"
        },
        "message_id": {
          "type": "string"
        },
        "branch_id": {
          "type": "string"
        },
        "sandbox_id": {
          "type": "string"
        },
        "runtime_session_id": {
          "type": "string"
        },
        "runtime_recording_id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time",
      "description": "Source occurrence time; may be out of order or affected by clock skew."
    },
    "actor": {
      "type": "object",
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "enum": [
            "principal",
            "agent",
            "system",
            "provider"
          ]
        },
        "id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "data": {
      "type": "object",
      "maxProperties": 256
    },
    "metadata": {
      "type": "object",
      "required": [
        "trace_id",
        "correlation_id"
      ],
      "properties": {
        "trace_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "correlation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "causation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "provider_instance_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "additionalProperties": false
    },
    "data_version": {
      "type": "integer",
      "minimum": 1
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time",
      "description": "Agent Platform durable ingest time."
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "producer_kind": { "const": "provider" } }, "required": ["producer_kind"] },
      "then": {
        "required": ["provider_revision_id"],
        "properties": {
          "provider_revision_id": { "type": "string" },
          "metadata": { "required": ["provider_instance_id"] }
        }
      },
      "else": {
        "properties": {
          "provider_revision_id": { "type": "null" },
          "metadata": { "not": { "required": ["provider_instance_id"] } }
        }
      }
    }
  ],
  "dependentRequired": {
    "work_order_id": ["turn_id", "branch_id", "input_message_id", "work_sequence"],
    "turn_id": ["work_order_id", "branch_id", "input_message_id", "work_sequence"],
    "branch_id": ["work_order_id", "turn_id", "input_message_id", "work_sequence"],
    "input_message_id": ["work_order_id", "turn_id", "branch_id", "work_sequence"],
    "work_sequence": ["work_order_id", "turn_id", "branch_id", "input_message_id"]
  },
  "x-semantic-constraints": [
    "Conversation lifecycle events omit the complete Work context group",
    "events for an executable Turn carry work_order_id, turn_id, branch_id, input_message_id and work_sequence as an all-or-none binding",
    "aggregate sequence and WorkOrder work_sequence are independent monotonic ledgers",
    "dedupe_key is RFC 8785 JCS SHA-256 over tenant_id, producer_id, source_stream_id and source_event_id",
    "Inbox uniqueness on tenant_id plus producer_id plus source_stream_id plus source_event_id rejects source retries before Projection",
    "producer_kind explicitly determines whether provider_revision_id and provider_instance_id are required or forbidden"
    ,"event_registry identifies exactly one admitted Platform Core or Agent Runtime Core Registry revision whose ownership matches producer_kind and whose type, data_version and Payload Schema admit this event; Provider-private registries are forbidden"
  ]
}
