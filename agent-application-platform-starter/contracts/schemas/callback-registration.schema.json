{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-platform:callback-registration:v1",
  "title": "CallbackRegistration",
  "type": "object",
  "required": [
    "callback_registration_id",
    "client_app_id",
    "endpoint",
    "authentication",
    "allowed_event_types",
    "status"
  ],
  "properties": {
    "callback_registration_id": {
      "type": "string"
    },
    "client_app_id": {
      "type": "string"
    },
    "endpoint": {
      "type": "string",
      "format": "uri"
    },
    "authentication": {
      "type": "object",
      "oneOf": [
        {
          "required": [
            "mode",
            "key_id"
          ],
          "properties": {
            "mode": {
              "const": "http_message_signature"
            },
            "key_id": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "required": [
            "mode",
            "certificate_profile_id"
          ],
          "properties": {
            "mode": {
              "const": "mtls"
            },
            "certificate_profile_id": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "allowed_event_types": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 60
    },
    "max_attempts": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "status": {
      "enum": [
        "active",
        "disabled",
        "quarantined"
      ]
    }
  },
  "additionalProperties": false
}
