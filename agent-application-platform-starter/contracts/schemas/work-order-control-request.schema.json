{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-platform:work-order-control-request:v1",
  "title": "WorkOrderControlRequest",
  "description": "Authorized control of an existing WorkOrder. This request never creates a Turn or successor WorkOrder.",
  "type": "object",
  "required": [
    "control_request_id", "work_order_id", "conversation_id", "branch_id", "action",
    "expected_message_head_sequence", "expected_active_work_version", "execution_grant"
  ],
  "properties": {
    "control_request_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "work_order_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "conversation_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "branch_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "action": { "enum": ["append_input", "interrupt", "pause", "resume", "cancel", "approval_decision"] },
    "expected_message_head_sequence": { "type": "integer", "minimum": 0 },
    "expected_active_work_version": { "type": "integer", "minimum": 1 },
    "content": { "$ref": "urn:agent-platform:runtime-input-envelope:v1" },
    "approval_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "decision": { "$ref": "urn:agent-platform:approval-decision:v1" },
    "reason": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "execution_grant": { "type": "string", "minLength": 20, "maxLength": 16384 },
    "metadata": {
      "type": "object",
      "maxProperties": 32,
      "additionalProperties": { "type": "string", "maxLength": 1000 }
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "action": { "enum": ["append_input", "interrupt"] } }, "required": ["action"] },
      "then": { "required": ["content"], "not": { "anyOf": [{ "required": ["approval_id"] }, { "required": ["decision"] }] } }
    },
    {
      "if": { "properties": { "action": { "const": "approval_decision" } }, "required": ["action"] },
      "then": { "required": ["approval_id", "decision"], "not": { "required": ["content"] } }
    },
    {
      "if": { "properties": { "action": { "enum": ["pause", "resume", "cancel"] } }, "required": ["action"] },
      "then": { "not": { "anyOf": [{ "required": ["content"] }, { "required": ["approval_id"] }, { "required": ["decision"] }] } }
    }
  ],
  "x-semantic-constraints": [
    "a fresh single-use ExecutionGrant binds the exact control request excluding execution_grant",
    "expected_message_head_sequence protects message ordering and expected_active_work_version protects active WorkOrder control; neither participates in WorkspaceRevision CAS",
    "append_input and interrupt persist an immutable authorized control input before an AgentRuntime command is emitted"
  ]
}
