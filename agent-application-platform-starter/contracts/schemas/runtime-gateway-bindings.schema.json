{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-platform:runtime-gateway-bindings:v1",
  "title": "RuntimeGatewayBindings",
  "description": "Explicit enabled or fail-closed disabled bindings for every governed Runtime egress class.",
  "type": "object",
  "required": ["model", "tool", "artifact", "egress"],
  "properties": {
    "model": { "$ref": "#/$defs/modelBinding" },
    "tool": { "$ref": "#/$defs/toolBinding" },
    "artifact": { "$ref": "#/$defs/artifactBinding" },
    "egress": { "$ref": "#/$defs/egressBinding" }
  },
  "additionalProperties": false,
  "$defs": {
    "disabledReason": {
      "enum": ["capability_absent", "not_required", "policy_denied", "commercially_unauthorized"]
    },
    "modelBinding": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "mode", "gateway_id", "route_id", "protocol_version", "binding_digest", "audience"],
          "properties": {
            "kind": { "const": "model" }, "mode": { "const": "enabled" },
            "gateway_id": { "type": "string", "minLength": 1, "maxLength": 200 },
            "route_id": { "type": "string", "minLength": 1, "maxLength": 200 },
            "protocol_version": { "const": "v1" },
            "binding_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
            "audience": { "type": "string", "minLength": 1, "maxLength": 300 }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "mode", "reason"],
          "properties": { "kind": { "const": "model" }, "mode": { "const": "disabled" }, "reason": { "$ref": "#/$defs/disabledReason" } },
          "additionalProperties": false
        }
      ]
    },
    "toolBinding": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "mode", "gateway_id", "route_id", "protocol_version", "binding_digest", "audience"],
          "properties": {
            "kind": { "const": "tool" }, "mode": { "const": "enabled" },
            "gateway_id": { "type": "string", "minLength": 1, "maxLength": 200 },
            "route_id": { "type": "string", "minLength": 1, "maxLength": 200 },
            "protocol_version": { "const": "v1" },
            "binding_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
            "audience": { "type": "string", "minLength": 1, "maxLength": 300 }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "mode", "reason"],
          "properties": { "kind": { "const": "tool" }, "mode": { "const": "disabled" }, "reason": { "$ref": "#/$defs/disabledReason" } },
          "additionalProperties": false
        }
      ]
    },
    "artifactBinding": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "mode", "gateway_id", "route_id", "protocol_version", "binding_digest", "audience"],
          "properties": {
            "kind": { "const": "artifact" }, "mode": { "const": "enabled" },
            "gateway_id": { "type": "string", "minLength": 1, "maxLength": 200 },
            "route_id": { "type": "string", "minLength": 1, "maxLength": 200 },
            "protocol_version": { "const": "v1" },
            "binding_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
            "audience": { "type": "string", "minLength": 1, "maxLength": 300 }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "mode", "reason"],
          "properties": { "kind": { "const": "artifact" }, "mode": { "const": "disabled" }, "reason": { "$ref": "#/$defs/disabledReason" } },
          "additionalProperties": false
        }
      ]
    },
    "egressBinding": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "mode", "gateway_id", "route_id", "protocol_version", "binding_digest", "audience"],
          "properties": {
            "kind": { "const": "egress" }, "mode": { "const": "enabled" },
            "gateway_id": { "type": "string", "minLength": 1, "maxLength": 200 },
            "route_id": { "type": "string", "minLength": 1, "maxLength": 200 },
            "protocol_version": { "const": "v1" },
            "binding_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
            "audience": { "type": "string", "minLength": 1, "maxLength": 300 }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "mode", "reason"],
          "properties": { "kind": { "const": "egress" }, "mode": { "const": "disabled" }, "reason": { "$ref": "#/$defs/disabledReason" } },
          "additionalProperties": false
        }
      ]
    }
  },
  "x-semantic-constraints": [
    "an enabled binding carries a typed route and audience while a disabled binding carries no routable identity",
    "a gateway required by ExecutionBudget or EffectivePermissions is enabled; disabled bindings are fail-closed and cannot be bypassed by a Provider"
  ]
}
