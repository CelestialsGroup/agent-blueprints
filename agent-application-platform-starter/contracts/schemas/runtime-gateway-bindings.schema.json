{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-platform:runtime-gateway-bindings:v1",
  "title": "RuntimeGatewayBindings",
  "description": "Explicit enabled or fail-closed disabled executable Port bindings for every governed Runtime egress class.",
  "type": "object",
  "required": ["model", "tool", "artifact", "egress"],
  "properties": {
    "model": { "$ref": "#/$defs/modelBinding" },
    "tool": { "$ref": "#/$defs/toolBinding" },
    "artifact": { "$ref": "#/$defs/artifactBinding" },
    "egress": { "$ref": "#/$defs/egressBinding" }
  },
  "additionalProperties": false,
  "$defs": {
    "disabledReason": {
      "enum": ["capability_absent", "not_required", "policy_denied", "commercially_unauthorized"]
    },
    "modelBinding": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "mode", "port"],
          "properties": {
            "kind": { "const": "model" },
            "mode": { "const": "enabled" },
            "port": { "$ref": "urn:agent-platform:gateway-port-binding:v1" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "mode", "reason"],
          "properties": {
            "kind": { "const": "model" },
            "mode": { "const": "disabled" },
            "reason": { "$ref": "#/$defs/disabledReason" }
          },
          "additionalProperties": false
        }
      ]
    },
    "toolBinding": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "mode", "port"],
          "properties": {
            "kind": { "const": "tool" },
            "mode": { "const": "enabled" },
            "port": { "$ref": "urn:agent-platform:gateway-port-binding:v1" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "mode", "reason"],
          "properties": {
            "kind": { "const": "tool" },
            "mode": { "const": "disabled" },
            "reason": { "$ref": "#/$defs/disabledReason" }
          },
          "additionalProperties": false
        }
      ]
    },
    "artifactBinding": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "mode", "port"],
          "properties": {
            "kind": { "const": "artifact" },
            "mode": { "const": "enabled" },
            "port": { "$ref": "urn:agent-platform:gateway-port-binding:v1" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "mode", "reason"],
          "properties": {
            "kind": { "const": "artifact" },
            "mode": { "const": "disabled" },
            "reason": { "$ref": "#/$defs/disabledReason" }
          },
          "additionalProperties": false
        }
      ]
    },
    "egressBinding": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "mode", "port"],
          "properties": {
            "kind": { "const": "egress" },
            "mode": { "const": "enabled" },
            "port": { "$ref": "urn:agent-platform:gateway-port-binding:v1" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "mode", "reason"],
          "properties": {
            "kind": { "const": "egress" },
            "mode": { "const": "disabled" },
            "reason": { "$ref": "#/$defs/disabledReason" }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "x-semantic-constraints": [
    "an enabled binding carries one typed executable Port whose gateway_kind equals the outer kind while a disabled binding carries no routable identity",
    "model and tool Ports use capability-provider-v1, Artifact uses artifact-gateway-v1 and Egress uses egress-gateway-v1",
    "a gateway required by ExecutionBudget or EffectivePermissions is enabled; disabled bindings are fail-closed and cannot be bypassed by a Provider"
  ]
}
