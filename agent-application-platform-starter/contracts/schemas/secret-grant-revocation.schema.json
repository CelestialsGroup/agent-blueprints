{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-platform:secret-grant-revocation:v1",
  "title": "SecretGrantRevocation",
  "type": "object",
  "required": ["revocation_id", "revocation_digest", "tenant_id", "secret_grant_id", "secret_grant_digest", "reason", "revoked_at"],
  "properties": {
    "revocation_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "revocation_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "tenant_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "secret_grant_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "secret_grant_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "reason": { "enum": ["principal_revoked", "commercial_authorization_revoked", "policy_revoked", "workload_revoked", "operation_cancelled", "operator_security_action"] },
    "revoked_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false,
  "x-semantic-constraints": [
    "revocation_digest is RFC 8785 JCS SHA-256 over the revocation excluding revocation_digest",
    "revocation is append-only and synchronously denies any unconsumed matching grant before asynchronous fanout"
  ]
}
