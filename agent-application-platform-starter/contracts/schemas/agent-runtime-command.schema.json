{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-platform:agent-runtime-command:v1",
  "title": "AgentRuntimeCommand",
  "type": "object",
  "required": [
    "command_id",
    "command_digest",
    "runtime_run_id",
    "command_sequence",
    "type",
    "invocation_attempt_id",
    "fencing_token",
    "idempotency_key",
    "deadline_at"
  ],
  "properties": {
    "command_id": { "type": "string", "minLength": 1 },
    "command_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "runtime_run_id": { "type": "string", "minLength": 1 },
    "command_sequence": { "type": "integer", "minimum": 1 },
    "type": { "enum": ["append_input", "interrupt", "pause", "resume", "cancel", "approval_decision", "checkpoint"] },
    "authorized_control_request_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "input_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "input_content_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "approval_id": { "type": "string", "minLength": 1 },
    "decision": { "$ref": "urn:agent-platform:approval-decision:v1" },
    "reason": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "invocation_attempt_id": { "type": "string", "minLength": 1 },
    "fencing_token": { "type": "integer", "minimum": 1 },
    "idempotency_key": { "type": "string", "minLength": 16 },
    "deadline_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "append_input" } }, "required": ["type"] },
      "then": {
        "required": ["authorized_control_request_id", "input_id", "input_content_digest"],
        "not": { "anyOf": [{ "required": ["approval_id"] }, { "required": ["decision"] }] }
      }
    },
    {
      "if": { "properties": { "type": { "const": "interrupt" } }, "required": ["type"] },
      "then": {
        "required": ["authorized_control_request_id", "input_id", "input_content_digest"],
        "not": { "anyOf": [{ "required": ["approval_id"] }, { "required": ["decision"] }] }
      }
    },
    {
      "if": { "properties": { "type": { "const": "approval_decision" } }, "required": ["type"] },
      "then": {
        "required": ["authorized_control_request_id", "approval_id", "decision"],
        "not": { "anyOf": [{ "required": ["input_id"] }, { "required": ["input_content_digest"] }] }
      }
    },
    {
      "if": { "properties": { "type": { "enum": ["pause", "resume", "cancel"] } }, "required": ["type"] },
      "then": {
        "required": ["authorized_control_request_id"],
        "not": {
          "anyOf": [
            { "required": ["input_id"] },
            { "required": ["input_content_digest"] },
            { "required": ["approval_id"] },
            { "required": ["decision"] }
          ]
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "checkpoint" } }, "required": ["type"] },
      "then": {
        "not": {
          "anyOf": [
            { "required": ["authorized_control_request_id"] },
            { "required": ["input_id"] },
            { "required": ["input_content_digest"] },
            { "required": ["approval_id"] },
            { "required": ["decision"] }
          ]
        }
      }
    }
  ],
  "x-semantic-constraints": [
    "command_digest is RFC 8785 JCS SHA-256 over the command excluding command_digest",
    "command_sequence is contiguous per runtime_run_id",
    "commands are append-only and repeated command_id plus digest is idempotent",
    "a stale fencing_token cannot mutate runtime state",
    "append_input and interrupt reference a persisted WorkOrderControlRequest and its immutable input; Runtime transport never accepts an unbound message ID",
    "the RuntimeInvocation token request_digest equals command_digest"
  ]
}
