{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-platform:artifact-ingest-request:v1",
  "title": "ArtifactIngestRequest",
  "type": "object",
  "required": [
    "name",
    "media_type",
    "size_bytes",
    "digest"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "media_type": {
      "type": "string"
    },
    "size_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "additionalProperties": false
}
