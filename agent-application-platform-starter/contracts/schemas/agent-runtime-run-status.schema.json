{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-platform:agent-runtime-run-status:v1",
  "title": "AgentRuntimeRunStatus",
  "type": "object",
  "required": [
    "runtime_run_id",
    "conversation_id",
    "work_order_id",
    "agent_run_id",
    "status",
    "last_command_sequence",
    "last_event_sequence",
    "observed_fencing_token",
    "updated_at"
  ],
  "properties": {
    "runtime_run_id": { "type": "string", "minLength": 1 },
    "conversation_id": { "type": "string", "minLength": 1 },
    "work_order_id": { "type": "string", "minLength": 1 },
    "agent_run_id": { "type": "string", "minLength": 1 },
    "status": { "enum": ["accepted", "running", "waiting_input", "waiting_approval", "paused", "cancel_requested", "succeeded", "failed", "cancelled", "outcome_unknown"] },
    "last_command_sequence": { "type": "integer", "minimum": 0 },
    "last_event_sequence": { "type": "integer", "minimum": 0 },
    "observed_fencing_token": { "type": "integer", "minimum": 1 },
    "checkpoint": { "$ref": "urn:agent-platform:agent-runtime-checkpoint-manifest:v1" },
    "result_reference": { "type": "string", "minLength": 1 },
    "error": { "$ref": "urn:agent-platform:capability-error:v1" },
    "updated_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "succeeded" } }, "required": ["status"] },
      "then": { "required": ["result_reference", "completed_at"], "not": { "required": ["error"] } }
    },
    {
      "if": { "properties": { "status": { "enum": ["failed", "outcome_unknown"] } }, "required": ["status"] },
      "then": { "required": ["error"] }
    },
    {
      "if": { "properties": { "status": { "enum": ["succeeded", "failed", "cancelled"] } }, "required": ["status"] },
      "then": { "required": ["completed_at"] }
    }
  ],
  "x-semantic-constraints": [
    "transitions follow contracts/state-machines/agent-runtime-run-v1.json",
    "cancel_requested is intent only; cancelled requires provider confirmation or reconciliation evidence",
    "outcome_unknown is non-terminal and must be reconciled through the Invocation Ledger"
  ]
}
