{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-platform:run-manifest:v2",
  "title": "RunManifestV2",
  "type": "object",
  "required": [
    "run_id",
    "work_order_id",
    "scenario",
    "workflow",
    "worker_build_id",
    "capability_resolutions",
    "sandboxes",
    "location",
    "request_digest",
    "execution_budget_digest",
    "policy_decision_digest",
    "event_schema_version",
    "agent_runtime",
    "run_manifest_digest",
    "temporal",
    "primary_sandbox_slot_key"
  ],
  "properties": {
    "run_id": {
      "type": "string"
    },
    "work_order_id": {
      "type": "string"
    },
    "scenario": {
      "type": "object",
      "required": [
        "id",
        "version",
        "definition_digest"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "definition_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "workflow": {
      "type": "object",
      "required": [
        "id",
        "version",
        "build_id",
        "definition_digest"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "build_id": {
          "type": "string"
        },
        "definition_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "worker_build_id": {
      "type": "string"
    },
    "capability_resolutions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "resolution_id",
          "capability",
          "selected_provider_instance_id",
          "routing_reason",
          "resolved_at",
          "selected_provider_revision",
          "capability_definition_digest"
        ],
        "properties": {
          "resolution_id": {
            "type": "string"
          },
          "capability": {
            "type": "object",
            "required": [
              "id",
              "version",
              "profile"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "version": {
                "type": "string"
              },
              "profile": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          },
          "selected_provider_instance_id": {
            "type": "string"
          },
          "routing_reason": {
            "enum": [
              "tenant_binding",
              "client_binding",
              "platform_default",
              "explicit_fallback"
            ]
          },
          "candidates_considered": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "resolved_at": {
            "type": "string",
            "format": "date-time"
          },
          "capability_definition_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "selected_provider_revision": {
            "type": "object",
            "required": [
              "provider_revision_id",
              "provider_kind",
              "plugin_id",
              "plugin_version",
              "manifest_digest",
              "package_digest",
              "runtime_binding_digest",
              "configuration_digest",
              "approved_permissions_digest",
              "credential_binding_digest",
              "conformance_report_digest",
              "certification_status"
            ],
            "properties": {
              "provider_revision_id": {
                "type": "string"
              },
              "plugin_id": {
                "type": "string"
              },
              "plugin_version": {
                "type": "string"
              },
              "manifest_digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "image_digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "configuration_digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "conformance_report_digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "provider_kind": {
                "enum": [
                  "agent_runtime",
                  "sandbox",
                  "model",
                  "tool",
                  "skill",
                  "template",
                  "renderer",
                  "editor",
                  "converter",
                  "channel"
                ]
              },
              "package_digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "runtime_binding_digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "approved_permissions_digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "credential_binding_digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "certification_status": {
                "const": "certified"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "agent_runtime": {
      "type": "object",
      "properties": {
        "provider_instance_id": {
          "type": "string"
        },
        "plugin_version": {
          "type": "string"
        },
        "runtime_version": {
          "type": "string"
        },
        "commit": {
          "type": "string"
        },
        "image_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "configuration_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "governed_conformance_report_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "provider_revision_id": {
          "type": "string"
        },
        "plugin_id": {
          "type": "string"
        },
        "package_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "runtime_binding_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "approved_permissions_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "credential_binding_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false,
      "required": [
        "provider_instance_id",
        "provider_revision_id",
        "plugin_id",
        "plugin_version",
        "runtime_version",
        "package_digest",
        "runtime_binding_digest",
        "configuration_digest",
        "approved_permissions_digest",
        "credential_binding_digest",
        "governed_conformance_report_digest"
      ]
    },
    "templates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "version",
          "source_digest"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "source_digest": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "location": {
      "type": "object",
      "required": [
        "region_id",
        "cluster_id",
        "cell_id"
      ],
      "properties": {
        "region_id": {
          "type": "string"
        },
        "cluster_id": {
          "type": "string"
        },
        "cell_id": {
          "type": "string"
        },
        "runtime_id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "request_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "execution_budget_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "policy_decision_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "event_schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "run_manifest_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "temporal": {
      "type": "object",
      "required": [
        "namespace",
        "workflow_id",
        "workflow_run_id",
        "workflow_type",
        "worker_deployment",
        "worker_build_id",
        "versioning_behavior"
      ],
      "properties": {
        "namespace": {
          "type": "string"
        },
        "workflow_id": {
          "type": "string"
        },
        "workflow_run_id": {
          "type": "string"
        },
        "workflow_type": {
          "type": "string"
        },
        "worker_deployment": {
          "type": "string"
        },
        "worker_build_id": {
          "type": "string"
        },
        "versioning_behavior": {
          "enum": [
            "pinned",
            "auto_upgrade"
          ]
        }
      },
      "additionalProperties": false
    },
    "sandboxes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "provider_instance_id",
          "provider_revision_id",
          "provider_api_version",
          "runtime_profile",
          "image_digest",
          "sandbox_spec_digest",
          "required_capabilities",
          "conformance_report_digest",
          "sandbox_slot_key",
          "sandbox_id"
        ],
        "properties": {
          "provider_instance_id": {
            "type": "string"
          },
          "provider_revision_id": {
            "type": "string"
          },
          "provider_api_version": {
            "const": "v1"
          },
          "runtime_profile": {
            "type": "string"
          },
          "image_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "sandbox_spec_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "required_capabilities": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "version"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "version": {
                  "type": "string"
                },
                "profile": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "conformance_report_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "sandbox_slot_key": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9/_-]{0,127}$",
            "description": "Logical Sandbox purpose inside a Workspace, e.g. primary-code or subagent/research-01."
          },
          "sandbox_id": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "primary_sandbox_slot_key": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9/_-]{0,127}$",
      "description": "Logical Sandbox purpose inside a Workspace, e.g. primary-code or subagent/research-01."
    }
  },
  "additionalProperties": false,
  "x-semantic-constraints": [
    "every Scenario required capability has exactly one compatible capability_resolution",
    "all selected ProviderRevisions are certified and not revoked at admission",
    "run_manifest_digest is RFC 8785 JCS SHA-256 over the manifest excluding run_manifest_digest",
    "agent_runtime and all Sandbox revisions remain immutable for the Run",
    "sandbox_slot_key is unique within the sandboxes array",
    "primary_sandbox_slot_key references exactly one sandboxes item"
  ]
}
