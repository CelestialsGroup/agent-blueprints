{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-platform:run-manifest:v2",
  "title": "RunManifestV2",
  "type": "object",
  "required": [
    "agent_run_id", "workflow_run_id", "tenant_id", "work_order_id", "scenario", "workflow", "capability_resolutions",
    "sandboxes", "location", "request_digest", "input", "context_package", "artifact_access_requirements",
    "execution_budget", "policy_decision", "effective_permissions", "gateway_bindings", "admission_limits",
    "authorization_renewal_policy",
    "event_registry", "agent_runtime",
    "run_manifest_digest", "orchestration_binding",
    "conversation", "selected_experiences", "commercial_authorization"
  ],
  "properties": {
    "agent_run_id": { "type": "string", "minLength": 1 },
    "workflow_run_id": { "type": "string", "minLength": 1 },
    "tenant_id": { "type": "string", "minLength": 1 },
    "work_order_id": { "type": "string", "minLength": 1 },
    "conversation": {
      "type": "object",
      "required": [
        "conversation_id", "turn_id", "branch_id", "input_message_id",
        "workspace_revision_id", "workspace_revision_digest"
      ],
      "properties": {
        "conversation_id": { "type": "string", "minLength": 1 },
        "turn_id": { "type": "string", "minLength": 1 },
        "branch_id": { "type": "string", "minLength": 1 },
        "input_message_id": { "type": "string", "minLength": 1 },
        "workspace_revision_id": { "type": "string", "minLength": 1 },
        "workspace_revision_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "scenario": {
      "type": "object",
      "required": ["id", "version", "definition_digest"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "definition_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "workflow": {
      "type": "object",
      "required": ["id", "version", "definition_build_id", "definition_digest"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "definition_build_id": {
          "type": "string",
          "minLength": 1,
          "description": "Build identity of the immutable workflow definition artifact, not the Temporal Worker Build ID."
        },
        "definition_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "capability_resolutions": {
      "type": "array",
      "items": { "$ref": "urn:agent-platform:provider-resolution:v1" },
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true
    },
    "agent_runtime": {
      "type": "object",
      "required": ["resolution_id"],
      "properties": {
        "resolution_id": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "selected_experiences": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": ["selection", "provider_instance_id", "provider_revision"],
        "properties": {
          "selection": { "$ref": "urn:agent-platform:selected-experience:v1" },
          "provider_instance_id": { "type": "string", "minLength": 1 },
          "provider_revision": { "$ref": "urn:agent-platform:provider-revision-snapshot:v1" }
        },
        "additionalProperties": false
      },
      "uniqueItems": true
    },
    "location": {
      "type": "object",
      "required": ["region_id", "cluster_id", "cell_id"],
      "properties": {
        "region_id": { "type": "string" },
        "cluster_id": { "type": "string" },
        "cell_id": { "type": "string" },
        "runtime_id": { "type": "string" }
      },
      "additionalProperties": false
    },
    "request_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "input": { "$ref": "urn:agent-platform:runtime-input-envelope:v1" },
    "context_package": { "$ref": "urn:agent-platform:context-package:v1" },
    "artifact_access_requirements": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": { "$ref": "urn:agent-platform:artifact-access-requirement:v1" }
    },
    "execution_budget": { "$ref": "urn:agent-platform:execution-budget:v1" },
    "policy_decision": { "$ref": "urn:agent-platform:policy-decision:v1" },
    "effective_permissions": { "$ref": "urn:agent-platform:effective-permissions:v1" },
    "gateway_bindings": { "$ref": "urn:agent-platform:runtime-gateway-bindings:v1" },
    "authorization_renewal_policy": { "$ref": "urn:agent-platform:authorization-renewal-policy:v1" },
    "admission_limits": {
      "type": "object",
      "required": ["max_encoded_request_bytes", "max_inline_input_bytes", "max_context_items", "max_artifact_grants"],
      "properties": {
        "max_encoded_request_bytes": { "const": 8388608 },
        "max_inline_input_bytes": { "const": 262144 },
        "max_context_items": { "const": 512 },
        "max_artifact_grants": { "const": 256 }
      },
      "additionalProperties": false
    },
    "commercial_authorization": {
      "$ref": "urn:agent-platform:commercial-authorization-binding:v1"
    },
    "event_registry": {
      "type": "object",
      "required": ["registry_id", "registry_version", "registry_digest"],
      "properties": {
        "registry_id": { "type": "string", "minLength": 1 },
        "registry_version": { "type": "integer", "minimum": 1 },
        "registry_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "run_manifest_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "orchestration_binding": { "$ref": "urn:agent-platform:orchestration-binding:v1" },
    "sandboxes": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "resolution_id", "provider_api_version",
          "runtime_profile", "sandbox_spec_digest", "required_capabilities",
          "sandbox_slot_key", "sandbox_id"
        ],
        "properties": {
          "resolution_id": { "type": "string", "minLength": 1 },
          "provider_api_version": { "const": "v1" },
          "runtime_profile": { "type": "string", "minLength": 1 },
          "sandbox_spec_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "required_capabilities": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "object",
              "required": ["id", "version"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "version": { "type": "string", "minLength": 1 },
                "profile": { "type": "string" }
              },
              "additionalProperties": false
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "sandbox_slot_key": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9/_-]{0,127}$"
          },
          "sandbox_id": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "primary_sandbox_slot_key": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9/_-]{0,127}$"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": { "sandboxes": { "minItems": 1 } },
        "required": ["sandboxes"]
      },
      "then": { "required": ["primary_sandbox_slot_key"] },
      "else": { "not": { "required": ["primary_sandbox_slot_key"] } }
    }
  ],
  "x-semantic-constraints": [
    "every Scenario required capability has exactly one compatible capability_resolution",
    "every capability_definition_digest binds the admitted CapabilityDefinition",
    "selected Provider kind is allowed and its conformance covers the resolved capability",
    "every Sandbox required_capabilities entry is covered by its Sandbox ProviderRevision conformance",
    "all selected ProviderRevisions have a latest certified admission decision at admission",
    "run_manifest_digest is RFC 8785 JCS SHA-256 over the manifest excluding run_manifest_digest",
    "agent_runtime.resolution_id references exactly one capability_resolution whose admitted ProviderRevision kind is agent_runtime",
    "the AgentRun runtime_provider_resolution_id equals agent_runtime.resolution_id",
    "all selected Agent Runtime, Sandbox and Experience revisions remain immutable for the Run",
    "each Sandbox resolution_id references exactly one capability_resolution whose selected ProviderRevision kind is sandbox",
    "sandbox_slot_key is unique within the sandboxes array",
    "primary_sandbox_slot_key is absent when sandboxes is empty and otherwise references exactly one sandboxes item"
    ,"selected_experiences exactly match the admitted WorkOrder selections and immutable Catalog revisions"
    ,"every selected experience ProviderRevision is certified and conformant for its capability"
    ,"tenant_id and conversation binding match the WorkOrder, input message and ExecutionGrant"
    ,"conversation WorkspaceRevision matches the admitted branch head captured for this Run"
    ,"agent_run_id and workflow_run_id match the immutable AgentRun and WorkflowRun records"
    ,"input, context_package and artifact_access_requirements are the complete bounded execution inputs admitted for this Run"
    ,"execution_budget, policy_decision and effective_permissions are immutable initial ceilings; short-lived RuntimeAuthorization revisions may remain equal or narrow them without changing the RunManifest"
    ,"gateway_bindings and authorization_renewal_policy are complete, typed and immutable for this Run"
    ,"commercial_authorization binds the exact immutable ID, digest and expiration ceiling while event_registry binds its exact immutable ID, version and digest"
    ,"orchestration_binding equals the WorkflowRun binding and contains no engine-native endpoint or mutable infrastructure identity"
  ]
}
