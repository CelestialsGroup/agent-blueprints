{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-platform:run-manifest:v2",
  "title": "RunManifestV2",
  "type": "object",
  "required": [
    "run_id", "work_order_id", "scenario", "workflow", "capability_resolutions",
    "sandboxes", "location", "request_digest", "execution_budget_digest",
    "policy_decision_digest", "event_schema_version", "agent_runtime",
    "run_manifest_digest", "temporal", "primary_sandbox_slot_key"
  ],
  "properties": {
    "run_id": { "type": "string", "minLength": 1 },
    "work_order_id": { "type": "string", "minLength": 1 },
    "scenario": {
      "type": "object",
      "required": ["id", "version", "definition_digest"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "definition_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "workflow": {
      "type": "object",
      "required": ["id", "version", "definition_build_id", "definition_digest"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "definition_build_id": {
          "type": "string",
          "minLength": 1,
          "description": "Build identity of the immutable workflow definition artifact, not the Temporal Worker Build ID."
        },
        "definition_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "capability_resolutions": {
      "type": "array",
      "items": { "$ref": "urn:agent-platform:provider-resolution:v1" },
      "minItems": 1,
      "uniqueItems": true
    },
    "agent_runtime": {
      "type": "object",
      "required": [
        "provider_instance_id", "provider_revision", "runtime_version",
        "governed_conformance_report_digest"
      ],
      "properties": {
        "provider_instance_id": { "type": "string", "minLength": 1 },
        "provider_revision": { "$ref": "urn:agent-platform:provider-revision-snapshot:v1" },
        "runtime_version": { "type": "string", "minLength": 1 },
        "commit": { "type": "string" },
        "governed_conformance_report_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "templates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "version", "source_digest"],
        "properties": {
          "id": { "type": "string" },
          "version": { "type": "string" },
          "source_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
        },
        "additionalProperties": false
      },
      "uniqueItems": true
    },
    "location": {
      "type": "object",
      "required": ["region_id", "cluster_id", "cell_id"],
      "properties": {
        "region_id": { "type": "string" },
        "cluster_id": { "type": "string" },
        "cell_id": { "type": "string" },
        "runtime_id": { "type": "string" }
      },
      "additionalProperties": false
    },
    "request_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "execution_budget_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "policy_decision_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "event_schema_version": { "type": "integer", "minimum": 1 },
    "run_manifest_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "temporal": {
      "type": "object",
      "required": [
        "namespace", "workflow_id", "workflow_run_id", "workflow_type",
        "worker_deployment", "worker_build_id", "versioning_behavior"
      ],
      "properties": {
        "namespace": { "type": "string", "minLength": 1 },
        "workflow_id": { "type": "string", "minLength": 1 },
        "workflow_run_id": { "type": "string", "minLength": 1 },
        "workflow_type": { "type": "string", "minLength": 1 },
        "worker_deployment": { "type": "string", "minLength": 1 },
        "worker_build_id": { "type": "string", "minLength": 1 },
        "versioning_behavior": { "enum": ["pinned", "auto_upgrade"] }
      },
      "additionalProperties": false
    },
    "sandboxes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "provider_instance_id", "provider_revision", "provider_api_version",
          "runtime_profile", "sandbox_spec_digest", "required_capabilities",
          "sandbox_slot_key", "sandbox_id"
        ],
        "properties": {
          "provider_instance_id": { "type": "string", "minLength": 1 },
          "provider_revision": { "$ref": "urn:agent-platform:provider-revision-snapshot:v1" },
          "provider_api_version": { "const": "v1" },
          "runtime_profile": { "type": "string", "minLength": 1 },
          "sandbox_spec_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "required_capabilities": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "version"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "version": { "type": "string", "minLength": 1 },
                "profile": { "type": "string" }
              },
              "additionalProperties": false
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "sandbox_slot_key": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9/_-]{0,127}$"
          },
          "sandbox_id": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "primary_sandbox_slot_key": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9/_-]{0,127}$"
    }
  },
  "additionalProperties": false,
  "x-semantic-constraints": [
    "every Scenario required capability has exactly one compatible capability_resolution",
    "all selected ProviderRevisions have a latest certified admission decision at admission",
    "run_manifest_digest is RFC 8785 JCS SHA-256 over the manifest excluding run_manifest_digest",
    "agent_runtime and all Sandbox revisions remain immutable for the Run",
    "sandbox_slot_key is unique within the sandboxes array",
    "primary_sandbox_slot_key references exactly one sandboxes item"
  ]
}
