{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-platform:provider-resolution:v1",
  "title": "ProviderResolution",
  "type": "object",
  "required": [
    "resolution_id", "capability", "selected_provider_instance_id",
    "routing_reason", "resolved_at", "selected_provider_revision",
    "capability_definition_digest"
  ],
  "properties": {
    "resolution_id": { "type": "string", "minLength": 1 },
    "capability": {
      "type": "object",
      "required": ["id", "version", "profile"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "profile": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "selected_provider_instance_id": { "type": "string", "minLength": 1 },
    "routing_reason": {
      "enum": ["tenant_binding", "client_binding", "scenario_requirement", "platform_default", "explicit_fallback"]
    },
    "candidates_considered": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "uniqueItems": true
    },
    "resolved_at": { "type": "string", "format": "date-time" },
    "capability_definition_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "selected_provider_revision": {
      "$ref": "urn:agent-platform:provider-revision-snapshot:v1"
    }
  },
  "additionalProperties": false
}
