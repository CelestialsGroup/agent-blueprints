{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-platform:provider-resolution:v1",
  "title": "ProviderResolution",
  "type": "object",
  "required": [
    "resolution_id", "tenant_id", "client_app_id", "work_order_id", "execution_scope", "identity_dependency", "principal_context_digest",
    "capability", "selected_provider_instance_id", "selected_provider_audience",
    "routing_reason", "resolved_at", "selected_provider_revision",
    "capability_definition_digest", "resolver_revision", "resolution_input_digest",
    "candidate_evaluations", "resolution_evidence_reference",
    "resolution_evidence_digest", "decision_digest"
  ],
  "properties": {
    "resolution_id": { "type": "string", "minLength": 1 },
    "tenant_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "client_app_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "work_order_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "execution_scope": { "const": "work_order" },
    "principal_context_digest": {
      "type": ["string", "null"],
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "identity_dependency": {
      "type": "object",
      "required": ["mode", "declaration_digest"],
      "properties": {
        "mode": { "enum": ["identity_independent", "principal_context"] },
        "declaration_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "capability": {
      "type": "object",
      "required": ["id", "version", "profile"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "profile": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "selected_provider_instance_id": { "type": "string", "minLength": 1 },
    "selected_provider_audience": {
      "type": "string",
      "pattern": "^urn:agent-platform:provider-instance:[A-Za-z0-9._:-]{1,200}$"
    },
    "routing_reason": {
      "enum": ["tenant_binding", "client_binding", "scenario_requirement", "platform_default", "explicit_fallback"]
    },
    "resolver_revision": {
      "type": "object",
      "required": ["id", "version", "digest"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "resolution_input_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "candidate_evaluations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "required": ["provider_instance_id", "provider_revision_id", "provider_audience", "outcome", "reason_codes", "evidence_digest"],
        "properties": {
          "provider_instance_id": { "type": "string", "minLength": 1 },
          "provider_revision_id": { "type": "string", "minLength": 1 },
          "provider_audience": {
            "type": "string",
            "pattern": "^urn:agent-platform:provider-instance:[A-Za-z0-9._:-]{1,200}$"
          },
          "outcome": { "enum": ["selected", "rejected"] },
          "reason_codes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "uniqueItems": true,
            "items": {
              "enum": [
                "binding_match", "scenario_match", "platform_default", "explicit_fallback",
                "scope_mismatch", "capability_mismatch", "conformance_missing", "admission_denied",
                "unhealthy", "capacity_unavailable", "placement_mismatch", "policy_denied", "lower_priority"
              ]
            }
          },
          "evidence_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
        },
        "additionalProperties": false
      }
    },
    "resolution_evidence_reference": { "type": "string", "minLength": 1 },
    "resolution_evidence_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "resolved_at": { "type": "string", "format": "date-time" },
    "capability_definition_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "selected_provider_revision": {
      "$ref": "urn:agent-platform:provider-revision-snapshot:v1"
    },
    "decision_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": { "identity_dependency": { "properties": { "mode": { "const": "principal_context" } } } },
        "required": ["identity_dependency"]
      },
      "then": { "properties": { "principal_context_digest": { "type": "string" } } },
      "else": { "properties": { "principal_context_digest": { "type": "null" } } }
    }
  ],
  "x-semantic-constraints": [
    "decision_digest is RFC 8785 JCS SHA-256 over the resolution excluding decision_digest",
    "resolution_input_digest binds the complete requirements, policy, placement, health and capacity inputs evaluated by resolver_revision",
    "tenant_id, client_app_id and work_order_id define the ownership and execution scope of the decision",
    "identity_dependency explicitly declares whether principal attributes affect selection and principal_context_digest is non-null exactly for principal_context mode",
    "candidate_evaluations contains exactly one selected candidate matching selected_provider_instance_id, selected_provider_audience and selected_provider_revision",
    "resolution_evidence_reference resolves to immutable evidence whose digest equals resolution_evidence_digest"
  ]
}
