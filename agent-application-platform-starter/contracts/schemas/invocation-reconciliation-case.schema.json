{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-platform:invocation-reconciliation-case:v1",
  "title": "InvocationReconciliationCase",
  "type": "object",
  "required": ["case_id", "invocation_id", "attempt_id", "status", "deadline_at", "opened_at", "updated_at", "evidence_references"],
  "properties": {
    "case_id": { "type": "string", "minLength": 1 },
    "invocation_id": { "type": "string", "minLength": 1 },
    "attempt_id": { "type": "string", "minLength": 1 },
    "status": { "enum": ["open", "querying", "manual_review", "resolved"] },
    "deadline_at": { "type": "string", "format": "date-time" },
    "evidence_references": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "resolved_outcome": { "enum": ["succeeded", "failed", "cancelled", "abandoned"] },
    "opened_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "resolved_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false,
  "allOf": [{ "if": { "properties": { "status": { "const": "resolved" } }, "required": ["status"] }, "then": { "required": ["resolved_outcome", "resolved_at"] } }]
}
