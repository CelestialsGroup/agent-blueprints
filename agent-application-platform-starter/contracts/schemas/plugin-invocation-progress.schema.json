{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-platform:plugin-invocation-progress:v1",
  "title": "PluginInvocationProgress",
  "type": "object",
  "required": [
    "invocation_id",
    "sequence",
    "occurred_at",
    "invocation_attempt_id",
    "fencing_token"
  ],
  "properties": {
    "invocation_id": {
      "type": "string"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "percent": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "message": {
      "type": "string"
    },
    "data": {
      "type": "object"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "invocation_attempt_id": {
      "type": "string"
    },
    "fencing_token": {
      "type": "integer",
      "minimum": 1
    }
  },
  "additionalProperties": false
}
