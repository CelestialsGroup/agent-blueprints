{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-platform:provider-revision:v1",
  "title": "ProviderRevision",
  "description": "Immutable provider implementation and configuration snapshot. Admission and revocation are separate append-only decisions.",
  "type": "object",
  "required": [
    "provider_revision_id", "provider_revision_digest", "provider_instance_id",
    "plugin_id", "plugin_version", "manifest_digest", "package_digest",
    "configuration_digest", "approved_permissions_digest", "runtime_binding_digest",
    "credential_binding_digest", "conformance", "conformance_set_digest", "provider_kind", "created_at"
  ],
  "properties": {
    "provider_revision_id": { "type": "string", "minLength": 1 },
    "provider_revision_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "provider_instance_id": { "type": "string", "minLength": 1 },
    "plugin_id": { "type": "string", "minLength": 1 },
    "plugin_version": { "type": "string", "minLength": 1 },
    "manifest_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "package_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "image_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "configuration_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "approved_permissions_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "runtime_binding_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "credential_binding_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "provider_kind": {
      "enum": ["agent_runtime", "sandbox", "model", "tool", "skill", "template", "renderer", "editor", "converter", "channel"]
    },
    "conformance": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["capability", "version", "profile", "suite_version", "status", "report_digest"],
        "properties": {
          "capability": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "profile": { "type": ["string", "null"] },
          "suite_version": { "type": "string", "minLength": 1 },
          "status": { "const": "passed" },
          "report_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
        },
        "additionalProperties": false
      }
    },
    "conformance_set_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "RFC 8785 digest of the complete ordered conformance array; required for every Provider kind."
    },
    "sandbox_conformance_report_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "governed_conformance_report_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "supersedes_revision_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false,
  "x-semantic-constraints": [
    "conformance_set_digest equals RFC 8785 JCS SHA-256 of conformance",
    "legacy kind-specific conformance digests, when present, equal conformance_set_digest",
    "provider_revision_digest equals RFC 8785 JCS SHA-256 of this object with provider_revision_digest omitted",
    "ProviderRevision is immutable after creation; certification and revocation are ProviderAdmissionDecision records"
  ]
}
