{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-platform:provider-revision:v1",
  "title": "ProviderRevision",
  "description": "Immutable Provider implementation, Port binding and configuration snapshot. Admission and revocation are separate append-only decisions.",
  "type": "object",
  "required": [
    "provider_revision_id",
    "provider_revision_digest",
    "provider_instance_id",
    "provider_kind",
    "implementation",
    "port",
    "configuration_digest",
    "approved_permissions_digest",
    "credential_binding_digest",
    "conformance",
    "conformance_set_digest",
    "created_at"
  ],
  "properties": {
    "provider_revision_id": { "type": "string", "minLength": 1 },
    "provider_revision_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "provider_instance_id": { "type": "string", "minLength": 1 },
    "provider_kind": {
      "enum": ["agent_runtime", "sandbox", "model", "tool", "skill", "template", "renderer", "editor", "converter", "channel"]
    },
    "implementation": { "$ref": "urn:agent-platform:provider-implementation:v1" },
    "port": { "$ref": "urn:agent-platform:provider-port-binding:v1" },
    "configuration_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "approved_permissions_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "credential_binding_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "conformance": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["capability", "version", "profile", "suite_id", "suite_version", "suite_digest", "suite_profile_id", "status", "report_digest"],
        "properties": {
          "capability": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "profile": { "type": ["string", "null"] },
          "suite_id": { "type": "string", "minLength": 1 },
          "suite_version": { "type": "string", "minLength": 1 },
          "suite_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "suite_profile_id": { "type": "string", "minLength": 1 },
          "status": { "const": "passed" },
          "report_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
        },
        "additionalProperties": false
      }
    },
    "conformance_set_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "RFC 8785 digest of the complete ordered conformance array."
    },
    "supersedes_revision_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "provider_kind": { "const": "agent_runtime" } }, "required": ["provider_kind"] },
      "then": {
        "properties": {
          "port": { "properties": { "protocol": { "const": "agent-runtime-provider" } } }
        }
      }
    },
    {
      "if": { "properties": { "provider_kind": { "const": "sandbox" } }, "required": ["provider_kind"] },
      "then": {
        "properties": {
          "port": { "properties": { "protocol": { "const": "sandbox-provider" } } }
        }
      }
    },
    {
      "if": {
        "properties": {
          "provider_kind": { "enum": ["model", "tool", "skill", "template", "renderer", "editor", "converter", "channel"] }
        },
        "required": ["provider_kind"]
      },
      "then": {
        "properties": {
          "port": { "properties": { "protocol": { "const": "capability-provider" } } }
        }
      }
    }
  ],
  "x-semantic-constraints": [
    "conformance_set_digest equals RFC 8785 JCS SHA-256 of conformance",
    "provider_revision_digest equals RFC 8785 JCS SHA-256 of this object with provider_revision_digest omitted",
    "ProviderRevision is immutable after creation; certification and revocation are ProviderAdmissionDecision records",
    "Provider implementation provenance, Port contract and binding are immutable and contain no mutable endpoint identity"
    ,"every conformance result binds an immutable Suite ID, version, digest and profile"
  ]
}
