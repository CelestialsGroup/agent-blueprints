{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-platform:provider-revision:v1",
  "title": "ProviderRevision",
  "type": "object",
  "required": [
    "provider_revision_id",
    "provider_instance_id",
    "plugin_id",
    "plugin_version",
    "manifest_digest",
    "configuration_digest",
    "approved_permissions_digest",
    "conformance",
    "created_at",
    "provider_kind",
    "package_digest",
    "runtime_binding_digest",
    "credential_binding_digest",
    "certification_status"
  ],
  "properties": {
    "provider_revision_id": {
      "type": "string"
    },
    "provider_instance_id": {
      "type": "string"
    },
    "plugin_id": {
      "type": "string"
    },
    "plugin_version": {
      "type": "string"
    },
    "manifest_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "package_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "image_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "configuration_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "approved_permissions_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "credential_binding_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "conformance": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "capability",
          "version",
          "profile",
          "suite_version",
          "status",
          "report_digest"
        ],
        "properties": {
          "capability": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "suite_version": {
            "type": "string"
          },
          "status": {
            "const": "passed"
          },
          "report_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "profile": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "supersedes_revision_id": {
      "type": "string"
    },
    "provider_kind": {
      "enum": [
        "agent_runtime",
        "sandbox",
        "model",
        "tool",
        "skill",
        "template",
        "renderer",
        "editor",
        "converter",
        "channel"
      ]
    },
    "sandbox_conformance_report_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "runtime_binding_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "certification_status": {
      "enum": [
        "certified",
        "revoked"
      ]
    },
    "revocation_reason": {
      "type": "string"
    },
    "governed_conformance_report_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "provider_kind": {
            "const": "agent_runtime"
          }
        },
        "required": [
          "provider_kind"
        ]
      },
      "then": {
        "required": [
          "governed_conformance_report_digest"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "provider_kind": {
            "const": "sandbox"
          }
        },
        "required": [
          "provider_kind"
        ]
      },
      "then": {
        "required": [
          "sandbox_conformance_report_digest"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "certification_status": {
            "const": "revoked"
          }
        },
        "required": [
          "certification_status"
        ]
      },
      "then": {
        "required": [
          "revocation_reason"
        ]
      }
    }
  ]
}
