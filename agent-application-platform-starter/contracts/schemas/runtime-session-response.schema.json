{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-platform:runtime-session-response:v1",
  "title": "RuntimeSessionResponse",
  "type": "object",
  "required": [
    "runtime_session_id",
    "runtime_type",
    "sandbox_slot_key",
    "gateway_protocol_version",
    "connection_generation",
    "connect_url",
    "expires_at",
    "scopes",
    "recording",
    "reconnect"
  ],
  "properties": {
    "runtime_session_id": {
      "type": "string"
    },
    "runtime_type": {
      "enum": [
        "terminal",
        "browser",
        "desktop",
        "port_forward"
      ]
    },
    "sandbox_slot_key": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9/_-]{0,127}$"
    },
    "gateway_protocol_version": { "const": "runtime-gateway/v1" },
    "connection_generation": { "type": "integer", "minimum": 1 },
    "connect_url": {
      "type": "string",
      "format": "uri"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "scopes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["view", "control", "input", "clipboard", "file-transfer"]
      }
    },
    "websocket_subprotocols": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "recording": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "enum": ["disabled", "recording"] },
        "recording_id": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "recording" } }, "required": ["status"] },
          "then": { "required": ["recording_id"] }
        }
      ]
    },
    "reconnect": {
      "type": "object",
      "required": ["resume_window_seconds", "heartbeat_interval_seconds", "max_frame_bytes"],
      "properties": {
        "resume_window_seconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
        "heartbeat_interval_seconds": { "type": "integer", "minimum": 1, "maximum": 60 },
        "max_frame_bytes": { "type": "integer", "minimum": 1024, "maximum": 1048576 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "runtime_type": { "const": "port_forward" } }, "required": ["runtime_type"] },
      "then": { "properties": { "recording": { "properties": { "status": { "const": "disabled" } } } } }
    }
  ],
  "x-semantic-constraints": [
    "scopes are the fail-closed intersection of the authenticated WorkSession, WorkOrder PolicyDecision and requested scopes",
    "sandbox_slot_key equals the request and one admitted RunManifest slot for the WorkOrder",
    "port_forward sessions always have recording.status disabled",
    "a platform_managed recording request cannot silently downgrade to disabled"
  ]
}
