{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-platform:agent-runtime-capabilities:v1",
  "title": "AgentRuntimeCapabilities",
  "type": "object",
  "required": ["protocol_version", "provider_revision_id", "runtime_name", "runtime_version", "features", "event_registries"],
  "properties": {
    "protocol_version": { "const": "v1" },
    "provider_revision_id": { "type": "string", "minLength": 1 },
    "runtime_name": { "type": "string", "minLength": 1 },
    "runtime_version": { "type": "string", "minLength": 1 },
    "features": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "runtime.start",
          "runtime.append-input",
          "runtime.interrupt",
          "runtime.pause",
          "runtime.resume",
          "runtime.cancel",
          "runtime.events.cursor",
          "runtime.checkpoint.export",
          "runtime.checkpoint.restore",
          "runtime.subagent",
          "runtime.approval",
          "runtime.artifact-staging",
          "runtime.usage"
        ]
      }
    },
    "event_registries": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["registry_id", "registry_version", "registry_digest"],
        "properties": {
          "registry_id": { "type": "string", "minLength": 1 },
          "registry_version": { "type": "integer", "minimum": 1 },
          "registry_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
        },
        "additionalProperties": false
      }
    },
    "checkpoint_profiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["profile_id", "suite_id", "suite_version", "suite_digest"],
        "properties": {
          "profile_id": { "type": "string", "minLength": 1, "maxLength": 200 },
          "suite_id": { "const": "agent-runtime-provider" },
          "suite_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
          "suite_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
        },
        "additionalProperties": false
      }
    },
    "limits": {
      "type": "object",
      "properties": {
        "max_input_bytes": { "type": "integer", "minimum": 1 },
        "max_event_batch": { "type": "integer", "minimum": 1 },
        "max_checkpoint_bytes": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": { "features": { "contains": { "enum": ["runtime.checkpoint.export", "runtime.checkpoint.restore"] } } },
        "required": ["features"]
      },
      "then": { "required": ["checkpoint_profiles"] }
    }
  ],
  "x-semantic-constraints": [
    "checkpoint export or restore is advertised only with content-addressed checkpoint Conformance Suite profiles",
    "capability advertisement does not authorize cross-revision restore without an exact CompatibilityDecision"
  ]
}
