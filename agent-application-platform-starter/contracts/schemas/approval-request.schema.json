{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-platform:approval-request:v1",
  "title": "ApprovalRequest",
  "type": "object",
  "required": [
    "approval_id",
    "work_order_id",
    "status",
    "risk_level",
    "action",
    "summary",
    "requested_at"
  ],
  "properties": {
    "approval_id": {
      "type": "string"
    },
    "work_order_id": {
      "type": "string"
    },
    "invocation_id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "pending",
        "approved",
        "rejected",
        "expired",
        "cancelled"
      ]
    },
    "risk_level": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "action": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "details": {
      "type": "object"
    },
    "requested_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
