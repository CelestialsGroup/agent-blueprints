{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-platform:agent-run-workspace-binding:v1",
  "title": "AgentRunWorkspaceBinding",
  "description": "Immutable mount and commit policy for one AgentRun over a branch-owned WorkspaceRevision.",
  "type": "object",
  "required": [
    "workspace_mode",
    "base_workspace_revision_id",
    "base_workspace_revision_digest",
    "mount_access",
    "commit_mode"
  ],
  "properties": {
    "workspace_mode": {
      "enum": ["read_only_parent_revision", "isolated_revision", "shared_branch_cas"]
    },
    "base_workspace_revision_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "base_workspace_revision_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "mount_access": { "enum": ["read_only", "copy_on_write"] },
    "commit_mode": { "enum": ["none", "isolated_revision_merge_cas", "shared_branch_cas"] },
    "expected_workspace_head_version": { "type": "integer", "minimum": 1 }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": { "workspace_mode": { "const": "read_only_parent_revision" } },
        "required": ["workspace_mode"]
      },
      "then": {
        "properties": {
          "mount_access": { "const": "read_only" },
          "commit_mode": { "const": "none" }
        },
        "not": { "required": ["expected_workspace_head_version"] }
      }
    },
    {
      "if": {
        "properties": { "workspace_mode": { "const": "isolated_revision" } },
        "required": ["workspace_mode"]
      },
      "then": {
        "required": ["expected_workspace_head_version"],
        "properties": {
          "mount_access": { "const": "copy_on_write" },
          "commit_mode": { "const": "isolated_revision_merge_cas" }
        }
      }
    },
    {
      "if": {
        "properties": { "workspace_mode": { "const": "shared_branch_cas" } },
        "required": ["workspace_mode"]
      },
      "then": {
        "required": ["expected_workspace_head_version"],
        "properties": {
          "mount_access": { "const": "copy_on_write" },
          "commit_mode": { "const": "shared_branch_cas" }
        }
      }
    }
  ]
}
