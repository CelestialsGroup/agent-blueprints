{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-platform:platform-core-event-data:v1",
  "title": "PlatformCoreEventDataV1",
  "description": "Closed payload registry for Agent Platform-owned CanonicalEvent types.",
  "$defs": {
    "conversationCreated": {
      "type": "object",
      "required": ["conversation_id", "workspace_id", "main_branch_id", "created_at"],
      "properties": {
        "conversation_id": { "type": "string", "minLength": 1 },
        "workspace_id": { "type": "string", "minLength": 1 },
        "main_branch_id": { "type": "string", "minLength": 1 },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "messageAppended": {
      "type": "object",
      "required": ["message_id", "message_sequence", "role", "content_digest"],
      "properties": {
        "message_id": { "type": "string", "minLength": 1 },
        "client_message_id": { "type": "string", "minLength": 1 },
        "message_sequence": { "type": "integer", "minimum": 1 },
        "role": { "enum": ["user", "assistant", "system", "tool"] },
        "content_reference": { "type": "string", "minLength": 1 },
        "content_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "workOrderAccepted": {
      "type": "object",
      "required": ["work_order_id", "turn_id", "input_message_id", "state"],
      "properties": {
        "work_order_id": { "type": "string", "minLength": 1 },
        "turn_id": { "type": "string", "minLength": 1 },
        "input_message_id": { "type": "string", "minLength": 1 },
        "state": { "const": "accepted" }
      },
      "additionalProperties": false
    },
    "workOrderControlAccepted": {
      "type": "object",
      "required": ["control_request_id", "action", "active_work_version"],
      "properties": {
        "control_request_id": { "type": "string", "minLength": 1 },
        "action": { "enum": ["append_input", "interrupt", "pause", "resume", "cancel", "approval_decision"] },
        "active_work_version": { "type": "integer", "minimum": 1 },
        "input_id": { "type": "string", "minLength": 1 },
        "input_message_id": { "type": "string", "minLength": 1 },
        "input_content_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "action": { "enum": ["append_input", "interrupt"] } }, "required": ["action"] },
          "then": { "required": ["input_id", "input_message_id", "input_content_digest"] },
          "else": { "not": { "anyOf": [{ "required": ["input_id"] }, { "required": ["input_message_id"] }, { "required": ["input_content_digest"] }] } }
        }
      ]
    },
    "systemSafetyControlIssued": {
      "type": "object",
      "required": [
        "safety_control_id",
        "runtime_run_id",
        "action",
        "reason",
        "trigger_evidence_digest",
        "control_digest",
        "issued_at"
      ],
      "properties": {
        "safety_control_id": { "type": "string", "minLength": 1 },
        "runtime_run_id": { "type": "string", "minLength": 1 },
        "action": { "enum": ["pause", "cancel"] },
        "reason": {
          "enum": [
            "commercial_authorization_expired",
            "commercial_authorization_revoked",
            "execution_deadline_exceeded",
            "policy_revoked",
            "tenant_suspended",
            "provider_admission_revoked",
            "budget_exhausted",
            "reconciliation_stop",
            "operator_emergency_stop",
            "platform_shutdown"
          ]
        },
        "trigger_evidence_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "control_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "issued_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "workOrderStateChanged": {
      "type": "object",
      "required": ["previous_state", "state", "transition", "state_version"],
      "properties": {
        "previous_state": { "$ref": "urn:agent-platform:work-order-state:v1" },
        "state": { "$ref": "urn:agent-platform:work-order-state:v1" },
        "transition": { "type": "string", "minLength": 1, "maxLength": 200 },
        "state_version": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "workflowRunStarted": {
      "type": "object",
      "required": ["workflow_run_id", "orchestration_binding_digest"],
      "properties": {
        "workflow_run_id": { "type": "string", "minLength": 1 },
        "orchestration_binding_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "workflowRunRootBound": {
      "type": "object",
      "required": ["workflow_run_id", "root_agent_run_id", "run_manifest_digest", "root_binding_digest"],
      "properties": {
        "workflow_run_id": { "type": "string", "minLength": 1 },
        "root_agent_run_id": { "type": "string", "minLength": 1 },
        "run_manifest_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "root_binding_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "agentRunStarted": {
      "type": "object",
      "required": [
        "agent_run_id", "workflow_run_id", "runtime_run_id", "run_manifest_digest",
        "runtime_provider_resolution_id", "run_kind", "root_agent_run_id", "run_depth",
        "required_for_work_order_completion"
      ],
      "properties": {
        "agent_run_id": { "type": "string", "minLength": 1 },
        "workflow_run_id": { "type": "string", "minLength": 1 },
        "runtime_run_id": { "type": "string", "minLength": 1 },
        "run_manifest_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "runtime_provider_resolution_id": { "type": "string", "minLength": 1 },
        "run_kind": { "enum": ["root", "subagent"] },
        "root_agent_run_id": { "type": "string", "minLength": 1 },
        "parent_agent_run_id": { "type": "string", "minLength": 1 },
        "spawn_request_id": { "type": "string", "minLength": 1 },
        "run_depth": { "type": "integer", "minimum": 0, "maximum": 64 },
        "required_for_work_order_completion": { "type": "boolean" }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "run_kind": { "const": "subagent" } }, "required": ["run_kind"] },
          "then": {
            "required": ["parent_agent_run_id", "spawn_request_id"],
            "properties": { "run_depth": { "minimum": 1 } }
          }
        },
        {
          "if": { "properties": { "run_kind": { "const": "root" } }, "required": ["run_kind"] },
          "then": {
            "properties": {
              "run_depth": { "const": 0 },
              "required_for_work_order_completion": { "const": true }
            },
            "not": {
              "anyOf": [
                { "required": ["parent_agent_run_id"] },
                { "required": ["spawn_request_id"] }
              ]
            }
          }
        }
      ]
    },
    "childAgentRunAdmissionDecided": {
      "type": "object",
      "required": ["decision_id", "decision_digest", "spawn_request_id", "outcome", "decided_at"],
      "properties": {
        "decision_id": { "type": "string", "minLength": 1 },
        "decision_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "spawn_request_id": { "type": "string", "minLength": 1 },
        "outcome": { "enum": ["accepted", "rejected"] },
        "child_agent_run_id": { "type": "string", "minLength": 1 },
        "decided_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "outcome": { "const": "accepted" } }, "required": ["outcome"] },
          "then": { "required": ["child_agent_run_id"] },
          "else": { "not": { "required": ["child_agent_run_id"] } }
        }
      ]
    },
    "agentRunStateChanged": {
      "type": "object",
      "required": ["agent_run_id", "runtime_run_id", "previous_state", "state", "state_version", "source"],
      "properties": {
        "agent_run_id": { "type": "string", "minLength": 1 },
        "runtime_run_id": { "type": "string", "minLength": 1 },
        "previous_state": { "enum": ["accepted", "running", "waiting_input", "waiting_approval", "paused", "cancel_requested", "succeeded", "failed", "cancelled", "outcome_unknown"] },
        "state": { "enum": ["accepted", "running", "waiting_input", "waiting_approval", "paused", "cancel_requested", "succeeded", "failed", "cancelled", "outcome_unknown"] },
        "state_version": { "type": "integer", "minimum": 1 },
        "source": { "enum": ["provider_event", "status_reconciliation", "control_fanout"] },
        "evidence_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "agentRunControlFanoutCreated": {
      "type": "object",
      "required": ["fanout_id", "fanout_digest", "action", "target_count", "authority_kind"],
      "properties": {
        "fanout_id": { "type": "string", "minLength": 1 },
        "fanout_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "action": { "enum": ["pause", "cancel"] },
        "target_count": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "authority_kind": { "enum": ["work_order_control_request", "system_safety_trigger"] }
      },
      "additionalProperties": false
    },
    "grantConsumed": {
      "type": "object",
      "required": ["grant_consumption_id", "grant_jti_digest", "request_contract_id", "request_digest"],
      "properties": {
        "grant_consumption_id": { "type": "string", "minLength": 1 },
        "grant_jti_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "request_contract_id": { "type": "string", "minLength": 1 },
        "request_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "approvalRequested": {
      "type": "object",
      "required": ["approval_id", "subject_kind", "subject_id", "policy_decision_digest", "requested_at"],
      "properties": {
        "approval_id": { "type": "string", "minLength": 1 },
        "subject_kind": { "enum": ["invocation", "runtime_command", "delivery", "artifact"] },
        "subject_id": { "type": "string", "minLength": 1 },
        "policy_decision_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "requested_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "approvalResolved": {
      "type": "object",
      "required": ["approval_id", "decision", "decision_id", "decided_at"],
      "properties": {
        "approval_id": { "type": "string", "minLength": 1 },
        "decision": { "enum": ["approved", "denied"] },
        "decision_id": { "type": "string", "minLength": 1 },
        "decided_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "invocationStateChanged": {
      "type": "object",
      "required": ["invocation_id", "invocation_attempt_id", "state", "fencing_token"],
      "properties": {
        "invocation_id": { "type": "string", "minLength": 1 },
        "invocation_attempt_id": { "type": "string", "minLength": 1 },
        "state": { "type": "string", "minLength": 1, "maxLength": 100 },
        "fencing_token": { "type": "integer", "minimum": 1 },
        "outcome_evidence_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "artifactVersionCreated": {
      "type": "object",
      "required": ["artifact_id", "version_id", "media_type", "digest"],
      "properties": {
        "artifact_id": { "type": "string", "minLength": 1 },
        "version_id": { "type": "string", "minLength": 1 },
        "media_type": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "usageRecorded": {
      "type": "object",
      "required": ["entry_id", "meter_id", "meter_version", "quantity", "unit", "measurement_status"],
      "properties": {
        "entry_id": { "type": "string", "minLength": 1 },
        "meter_id": { "type": "string", "minLength": 1 },
        "meter_version": { "type": "integer", "minimum": 1 },
        "quantity": { "type": "integer" },
        "unit": { "enum": ["token", "millisecond", "nanosecond", "byte", "byte_millisecond", "count"] },
        "measurement_status": { "enum": ["confirmed", "partial", "estimated", "corrected"] }
      },
      "additionalProperties": false
    },
    "workspaceRevisionCommitted": {
      "type": "object",
      "required": ["workspace_revision_id", "workspace_revision_digest", "previous_revision_id", "workspace_head_version"],
      "properties": {
        "workspace_revision_id": { "type": "string", "minLength": 1 },
        "workspace_revision_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "previous_revision_id": { "type": ["string", "null"] },
        "workspace_head_version": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "runtimeSessionOpened": {
      "type": "object",
      "required": ["runtime_session_id", "runtime_type", "sandbox_slot_key", "expires_at"],
      "properties": {
        "runtime_session_id": { "type": "string", "minLength": 1 },
        "runtime_type": { "enum": ["terminal", "browser", "desktop", "port_forward"] },
        "sandbox_slot_key": { "type": "string", "minLength": 1 },
        "expires_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "runtimeRecordingReady": {
      "type": "object",
      "required": ["runtime_recording_id", "manifest_artifact_id", "manifest_version_id", "manifest_digest"],
      "properties": {
        "runtime_recording_id": { "type": "string", "minLength": 1 },
        "manifest_artifact_id": { "type": "string", "minLength": 1 },
        "manifest_version_id": { "type": "string", "minLength": 1 },
        "manifest_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "deliveryStateChanged": {
      "type": "object",
      "required": ["delivery_id", "state", "attempt_number"],
      "properties": {
        "delivery_id": { "type": "string", "minLength": 1 },
        "state": { "type": "string", "minLength": 1, "maxLength": 100 },
        "attempt_number": { "type": "integer", "minimum": 1 },
        "receipt_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "conversationBranchChanged": {
      "type": "object",
      "required": ["branch_request_id", "branch_id", "mode", "request_digest", "workspace_revision_id", "workspace_revision_digest"],
      "properties": {
        "branch_request_id": { "type": "string", "minLength": 1 },
        "branch_id": { "type": "string", "minLength": 1 },
        "mode": { "enum": ["create", "fork"] },
        "source_branch_id": { "type": "string", "minLength": 1 },
        "source_message_id": { "type": ["string", "null"] },
        "source_message_sequence": { "type": "integer", "minimum": 0 },
        "workspace_revision_id": { "type": "string", "minLength": 1 },
        "workspace_revision_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "request_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "artifactOperationStateChanged": {
      "type": "object",
      "required": ["artifact_operation_id", "operation_kind", "state", "state_version", "request_digest"],
      "properties": {
        "artifact_operation_id": { "type": "string", "minLength": 1 },
        "operation_kind": { "enum": ["preview", "edit", "conversion"] },
        "state": { "enum": ["accepted", "resolving", "queued", "running", "reconciling", "cancel_requested", "cancelling", "cancellation_reconciling", "succeeded", "failed", "cancelled"] },
        "state_version": { "type": "integer", "minimum": 1 },
        "provider_resolution_id": { "type": "string", "minLength": 1 },
        "invocation_id": { "type": "string", "minLength": 1 },
        "request_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "invocation_request_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "cancellation_intent_id": { "type": "string", "minLength": 1 },
        "cancellation_source_kind": {
          "enum": [
            "commercial_authorization_revocation_receipt", "commercial_authorization_expiry",
            "deadline", "budget_exhaustion", "tenant_suspension", "provider_revocation",
            "platform_emergency"
          ]
        },
        "cancellation_source_id": { "type": "string", "minLength": 1 },
        "cancellation_source_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "cancellation_outbox_message_id": { "type": "string", "minLength": 1 },
        "cancellation_requested_at": { "type": "string", "format": "date-time" },
        "cancellation_reconciliation_case_id": { "type": "string", "minLength": 1 },
        "terminal_stage": { "enum": ["admission", "resolution", "dispatch", "execution", "finalization"] },
        "terminal_evidence_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "state": { "enum": ["running", "reconciling", "cancelling", "cancellation_reconciling", "succeeded"] } }, "required": ["state"] },
          "then": { "required": ["provider_resolution_id", "invocation_id", "invocation_request_digest"] }
        },
        {
          "if": { "properties": { "state": { "enum": ["cancel_requested", "cancelling", "cancellation_reconciling", "cancelled"] } }, "required": ["state"] },
          "then": {
            "required": [
              "cancellation_intent_id", "cancellation_source_kind", "cancellation_source_id",
              "cancellation_source_digest", "cancellation_outbox_message_id", "cancellation_requested_at"
            ]
          }
        },
        {
          "if": { "properties": { "state": { "const": "cancellation_reconciling" } }, "required": ["state"] },
          "then": { "required": ["cancellation_reconciliation_case_id"] }
        },
        {
          "if": { "properties": { "state": { "enum": ["succeeded", "failed", "cancelled"] } }, "required": ["state"] },
          "then": { "required": ["terminal_stage", "terminal_evidence_digest"] }
        },
        {
          "if": { "properties": { "terminal_stage": { "enum": ["admission", "resolution", "dispatch"] } }, "required": ["terminal_stage"] },
          "then": { "not": { "anyOf": [
            { "required": ["invocation_id"] }, { "required": ["invocation_request_digest"] }
          ] } }
        },
        {
          "if": { "properties": { "terminal_stage": { "enum": ["execution", "finalization"] } }, "required": ["terminal_stage"] },
          "then": { "required": ["provider_resolution_id", "invocation_id", "invocation_request_digest"] }
        }
      ]
    },
    "noUsageConfirmed": {
      "type": "object",
      "required": ["attestation_id", "attestation_digest", "reason", "evidence_digest"],
      "properties": {
        "attestation_id": { "type": "string", "minLength": 1 },
        "attestation_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "reason": { "enum": ["failed_before_dispatch", "cancelled_before_dispatch", "admission_rejected_before_dispatch"] },
        "evidence_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "artifactIngestStateChanged": {
      "type": "object",
      "required": ["ingest_session_id", "state", "state_version", "content_digest"],
      "properties": {
        "ingest_session_id": { "type": "string", "minLength": 1 },
        "state": { "enum": ["created", "uploading", "uploaded", "scan_pending", "scanning", "ready_to_finalize", "finalized", "rejected", "expired"] },
        "state_version": { "type": "integer", "minimum": 1 },
        "content_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "scan_result_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "artifact_version_id": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "compatibilityDecided": {
      "type": "object",
      "required": ["decision_id", "decision_digest", "subject_kind", "subject_id", "result", "source_provider_revision_id", "target_provider_revision_id"],
      "properties": {
        "decision_id": { "type": "string", "minLength": 1 },
        "decision_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "subject_kind": { "enum": ["runtime_checkpoint", "sandbox_snapshot"] },
        "subject_id": { "type": "string", "minLength": 1 },
        "result": { "enum": ["compatible", "incompatible"] },
        "source_provider_revision_id": { "type": "string", "minLength": 1 },
        "target_provider_revision_id": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "secretGrantChanged": {
      "type": "object",
      "required": ["secret_grant_id", "secret_grant_digest", "state", "evidence_digest"],
      "properties": {
        "secret_grant_id": { "type": "string", "minLength": 1 },
        "secret_grant_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "state": { "enum": ["issued", "consumed", "revoked", "expired"] },
        "evidence_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "credentialAccessed": {
      "type": "object",
      "required": ["credential_request_id", "secret_grant_id", "provider_revision_id", "target_kind", "target_id", "purpose", "request_digest"],
      "properties": {
        "credential_request_id": { "type": "string", "minLength": 1 },
        "secret_grant_id": { "type": "string", "minLength": 1 },
        "provider_revision_id": { "type": "string", "minLength": 1 },
        "target_kind": { "enum": ["sandbox_exec", "capability_invocation", "artifact_operation"] },
        "target_id": { "type": "string", "minLength": 1 },
        "purpose": { "enum": ["process_environment", "file_mount", "http_header"] },
        "request_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/conversationCreated" },
    { "$ref": "#/$defs/messageAppended" },
    { "$ref": "#/$defs/workOrderAccepted" },
    { "$ref": "#/$defs/workOrderControlAccepted" },
    { "$ref": "#/$defs/systemSafetyControlIssued" },
    { "$ref": "#/$defs/workOrderStateChanged" },
    { "$ref": "#/$defs/workflowRunStarted" },
    { "$ref": "#/$defs/workflowRunRootBound" },
    { "$ref": "#/$defs/agentRunStarted" },
    { "$ref": "#/$defs/childAgentRunAdmissionDecided" },
    { "$ref": "#/$defs/agentRunStateChanged" },
    { "$ref": "#/$defs/agentRunControlFanoutCreated" },
    { "$ref": "#/$defs/grantConsumed" },
    { "$ref": "#/$defs/approvalRequested" },
