{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-platform:credential-access-request:v1",
  "title": "CredentialAccessRequest",
  "type": "object",
  "required": ["credential_request_id", "secret_grant_id", "secret_grant_digest", "secret_reference_ids", "target", "purpose", "request_digest"],
  "properties": {
    "credential_request_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "secret_grant_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "secret_grant_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "secret_reference_ids": {
      "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 200 }
    },
    "target": {
      "type": "object",
      "required": ["target_kind", "target_id", "target_digest"],
      "properties": {
        "target_kind": { "enum": ["sandbox_exec", "capability_invocation", "artifact_operation"] },
        "target_id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "target_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "purpose": { "enum": ["process_environment", "file_mount", "http_header"] },
    "request_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  },
  "additionalProperties": false,
  "x-semantic-constraints": [
    "request_digest is RFC 8785 JCS SHA-256 over the request excluding request_digest",
    "all requested references, purpose and target exactly match the immutable SecretGrant"
  ]
}
