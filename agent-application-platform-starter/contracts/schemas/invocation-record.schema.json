{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-platform:invocation-record:v1",
  "title": "InvocationRecord",
  "type": "object",
  "required": [
    "invocation_id",
    "tenant_id",
    "work_order_id",
    "workflow_run_id",
    "workflow_step_id",
    "capability_id",
    "capability_version",
    "provider_instance_id",
    "idempotency_key",
    "request_digest",
    "side_effect",
    "status",
    "created_at",
    "updated_at",
    "attempt_count",
    "max_attempts"
  ],
  "properties": {
    "invocation_id": {
      "type": "string"
    },
    "tenant_id": {
      "type": "string"
    },
    "work_order_id": {
      "type": "string"
    },
    "workflow_run_id": {
      "type": "string"
    },
    "workflow_step_id": {
      "type": "string"
    },
    "capability_id": {
      "type": "string"
    },
    "capability_version": {
      "type": "string"
    },
    "provider_instance_id": {
      "type": "string"
    },
    "idempotency_key": {
      "type": "string"
    },
    "request_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "side_effect": {
      "enum": [
        "pure",
        "idempotent",
        "externally_idempotent",
        "non_idempotent"
      ]
    },
    "status": {
      "enum": [
        "prepared",
        "executing",
        "retry_scheduled",
        "outcome_unknown",
        "reconciling",
        "manual_review",
        "succeeded",
        "failed",
        "cancel_requested",
        "cancelled",
        "abandoned"
      ]
    },
    "provider_operation_id": {
      "type": "string"
    },
    "result_reference": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "attempt_count": {
      "type": "integer",
      "minimum": 0
    },
    "max_attempts": {
      "type": "integer",
      "minimum": 1
    },
    "next_retry_at": {
      "type": "string",
      "format": "date-time"
    },
    "reconciliation_deadline_at": {
      "type": "string",
      "format": "date-time"
    },
    "manual_review_case_id": {
      "type": "string"
    },
    "terminal_reason": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
