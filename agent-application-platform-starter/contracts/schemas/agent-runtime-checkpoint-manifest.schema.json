{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-platform:agent-runtime-checkpoint-manifest:v1",
  "title": "AgentRuntimeCheckpointManifest",
  "type": "object",
  "required": [
    "checkpoint_id", "runtime_run_id", "provider_revision_id", "source_runtime_revision",
    "event_sequence", "content_reference", "digest", "size_bytes", "portability",
    "compatibility_profile", "created_at"
  ],
  "properties": {
    "checkpoint_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "runtime_run_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "provider_revision_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "source_runtime_revision": { "type": "string", "minLength": 1, "maxLength": 200 },
    "event_sequence": { "type": "integer", "minimum": 0 },
    "content_reference": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "size_bytes": { "type": "integer", "minimum": 0 },
    "portability": { "enum": ["same_revision", "compatible_revision", "portable"] },
    "compatibility_profile": { "type": "string", "minLength": 1, "maxLength": 200 },
    "compatibility_decision": { "$ref": "urn:agent-platform:compatibility-decision:v1" },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "portability": { "enum": ["compatible_revision", "portable"] } }, "required": ["portability"] },
      "then": { "required": ["compatibility_decision"] },
      "else": { "not": { "required": ["compatibility_decision"] } }
    }
  ],
  "x-semantic-constraints": [
    "compatible_revision and portable require an immutable Platform CompatibilityDecision for the exact checkpoint digest, source revision, target revision and compatibility profile",
    "same_revision restore requires exact ProviderRevision and runtime revision equality; any mismatch fails closed before dispatch",
    "a Provider portability label without admitted Suite evidence cannot authorize restore"
  ]
}
