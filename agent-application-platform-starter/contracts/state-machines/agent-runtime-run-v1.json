{
  "machine_id": "agent-runtime-run",
  "version": 1,
  "initial_state": "accepted",
  "terminal_states": ["succeeded", "failed", "cancelled"],
  "transitions": [
    { "from": "accepted", "event": "start_confirmed", "to": "running" },
    { "from": "accepted", "event": "start_known_failed", "to": "failed" },
    { "from": "accepted", "event": "start_outcome_unknown", "to": "outcome_unknown" },
    { "from": "accepted", "event": "cancel_requested", "to": "cancel_requested" },
    { "from": "running", "event": "input_required", "to": "waiting_input" },
    { "from": "running", "event": "approval_required", "to": "waiting_approval" },
    { "from": "running", "event": "pause_confirmed", "to": "paused" },
    { "from": "running", "event": "succeeded", "to": "succeeded" },
    { "from": "running", "event": "known_failed", "to": "failed" },
    { "from": "running", "event": "cancel_requested", "to": "cancel_requested" },
    { "from": "running", "event": "outcome_unknown", "to": "outcome_unknown" },
    { "from": "waiting_input", "event": "input_accepted", "to": "running" },
    { "from": "waiting_input", "event": "cancel_requested", "to": "cancel_requested" },
    { "from": "waiting_input", "event": "known_failed", "to": "failed" },
    { "from": "waiting_input", "event": "outcome_unknown", "to": "outcome_unknown" },
    { "from": "waiting_approval", "event": "approval_accepted", "to": "running" },
    { "from": "waiting_approval", "event": "approval_rejected", "to": "failed" },
    { "from": "waiting_approval", "event": "cancel_requested", "to": "cancel_requested" },
    { "from": "waiting_approval", "event": "outcome_unknown", "to": "outcome_unknown" },
    { "from": "paused", "event": "resume_confirmed", "to": "running" },
    { "from": "paused", "event": "cancel_requested", "to": "cancel_requested" },
    { "from": "paused", "event": "known_failed", "to": "failed" },
    { "from": "paused", "event": "outcome_unknown", "to": "outcome_unknown" },
    { "from": "cancel_requested", "event": "cancel_confirmed", "to": "cancelled" },
    { "from": "cancel_requested", "event": "provider_reports_success", "to": "succeeded" },
    { "from": "cancel_requested", "event": "provider_reports_failure", "to": "failed" },
    { "from": "cancel_requested", "event": "cancel_outcome_unknown", "to": "outcome_unknown" },
    { "from": "outcome_unknown", "event": "evidence_running", "to": "running" },
    { "from": "outcome_unknown", "event": "evidence_waiting_input", "to": "waiting_input" },
    { "from": "outcome_unknown", "event": "evidence_waiting_approval", "to": "waiting_approval" },
    { "from": "outcome_unknown", "event": "evidence_paused", "to": "paused" },
    { "from": "outcome_unknown", "event": "evidence_succeeded", "to": "succeeded" },
    { "from": "outcome_unknown", "event": "evidence_failed", "to": "failed" },
    { "from": "outcome_unknown", "event": "evidence_cancelled", "to": "cancelled" },
    { "from": "outcome_unknown", "event": "cancel_intent_recorded", "to": "outcome_unknown" }
  ]
}
