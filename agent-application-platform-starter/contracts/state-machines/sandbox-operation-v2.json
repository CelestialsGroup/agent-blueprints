{
  "machine_id": "sandbox-operation-record",
  "version": 2,
  "initial_state": "pending",
  "terminal_states": ["succeeded", "failed", "cancelled", "abandoned"],
  "transitions": [
    { "from": "pending", "event": "attempt_started", "to": "running" },
    { "from": "pending", "event": "cancel_before_dispatch", "to": "cancelled" },
    { "from": "running", "event": "attempt_succeeded", "to": "succeeded" },
    { "from": "running", "event": "attempt_known_failed", "to": "failed" },
    { "from": "running", "event": "retryable_failure", "to": "retry_scheduled" },
    { "from": "running", "event": "outcome_unknown", "to": "reconciling" },
    { "from": "running", "event": "cancel_requested", "to": "cancel_requested" },
    { "from": "retry_scheduled", "event": "retry_due", "to": "running" },
    { "from": "retry_scheduled", "event": "cancel_without_inflight_attempt", "to": "cancelled" },
    { "from": "cancel_requested", "event": "provider_cancel_confirmed", "to": "cancellation_confirmed" },
    { "from": "cancel_requested", "event": "provider_reports_success", "to": "succeeded" },
    { "from": "cancel_requested", "event": "provider_reports_failure", "to": "failed" },
    { "from": "cancel_requested", "event": "cancel_outcome_unknown", "to": "reconciling" },
    { "from": "reconciling", "event": "cancellation_intent_recorded", "to": "reconciling" },
    { "from": "reconciling", "event": "evidence_succeeded", "to": "succeeded" },
    { "from": "reconciling", "event": "evidence_failed", "to": "failed" },
    { "from": "reconciling", "event": "evidence_cancelled", "to": "cancellation_confirmed" },
    { "from": "reconciling", "event": "retry_approved", "to": "retry_scheduled" },
    { "from": "reconciling", "event": "deadline_expired", "to": "manual_review_required" },
    { "from": "manual_review_required", "event": "cancellation_intent_recorded", "to": "manual_review_required" },
    { "from": "manual_review_required", "event": "resolve_success", "to": "succeeded" },
    { "from": "manual_review_required", "event": "resolve_failure", "to": "failed" },
    { "from": "manual_review_required", "event": "resolve_cancelled", "to": "cancellation_confirmed" },
    { "from": "manual_review_required", "event": "retry_approved", "to": "retry_scheduled" },
    { "from": "manual_review_required", "event": "abandon_with_risk_acceptance", "to": "abandoned" },
    { "from": "cancellation_confirmed", "event": "terminal_record_committed", "to": "cancelled" }
  ]
}
