{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-platform:plugin-config:html-to-pptx:v1",
  "title": "HtmlToPptxConfiguration",
  "type": "object",
  "properties": {
    "chromium_pool_size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32
    },
    "max_input_bytes": {
      "type": "integer",
      "minimum": 1
    },
    "default_profile": {
      "enum": [
        "fast",
        "balanced",
        "editable"
      ]
    }
  },
  "additionalProperties": false
}
