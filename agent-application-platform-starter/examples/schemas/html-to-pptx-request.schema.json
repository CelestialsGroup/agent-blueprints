{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-platform:capability-schema:html-to-pptx-request:v1",
  "title": "HtmlToPptxRequest",
  "type": "object",
  "required": [
    "slide_size",
    "profile"
  ],
  "properties": {
    "slide_size": {
      "enum": [
        "16:9",
        "4:3",
        "A4"
      ]
    },
    "profile": {
      "enum": [
        "fast",
        "balanced",
        "editable"
      ]
    },
    "include_speaker_notes": {
      "type": "boolean"
    },
    "font_policy": {
      "enum": [
        "embed_or_replace",
        "replace",
        "fail"
      ]
    }
  },
  "additionalProperties": false
}
